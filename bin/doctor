#!/usr/bin/env bash
# Health-check Claude Code setup — catches silent drift (vanished hooks/agents, missing secrets).
set -uo pipefail

# Claude Code reads its user config from $CLAUDE_CONFIG_DIR when set, ~/.claude otherwise.
# Mirrors install.sh: anything else and this operates on a directory the install never used.
CDIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then CJSON="$CDIR/.claude.json"; else CJSON="$HOME/.claude.json"; fi

# --drift: compare the INSTALLED state (~/.claude, ~/.config/agents/bin) against the vstack
# repo checkout it came from.
#
# WHY this matters: editing ~/.claude (or ~/.config/agents/bin) directly appears to work, but
# the next `install.sh` run silently overwrites those files back to whatever the repo has.
# Drift reported here is unsaved work that is one `vstack update` away from being lost without
# any warning.
resolve_vstack_repo() {
    if [ -n "${VSTACK_DIR:-}" ] && [ -f "$VSTACK_DIR/claude/settings.json" ]; then
      printf '%s\n' "$VSTACK_DIR"; return 0
    fi
    # install.sh records where it last ran from, so a repo cloned anywhere is findable.
    if [ -f "$HOME/.config/agents/vstack-repo" ]; then
      p=$(cat "$HOME/.config/agents/vstack-repo")
      [ -f "$p/claude/settings.json" ] && { printf '%s\n' "$p"; return 0; }
    fi
    if [ -f "$HOME/.vstack/claude/settings.json" ]; then
      printf '%s\n' "$HOME/.vstack"; return 0
    fi
    sdir=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || sdir=""
    root=""
    [ -n "$sdir" ] && root=$(cd "$sdir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
    if [ -n "${root:-}" ] && [ -f "$root/claude/settings.json" ]; then
      printf '%s\n' "$root"; return 0
    fi
    return 1
}

# Body of `--drift`, factored into a function so `--json` can call it directly (no re-exec, no
# subshell -- DRIFT/COMPARED stay real bash globals afterward) and still get the exact same
# comparison `doctor --drift` alone gets. `return`, not `exit`, throughout: `--drift` itself
# calls this and then exits with its result immediately below; `--json` calls it with stdout
# redirected, reads DRIFT/COMPARED back, and keeps running.
run_drift() {
  # Exits 1, not 0. Reporting "nothing to compare" and succeeding meant a cron or CI wrapper
  # on a machine where the checkout had moved got a green result forever while comparing
  # nothing. bin/vstack already exits 1 in this exact situation; the two disagreed.
  REPO=$(resolve_vstack_repo) || {
    echo "doctor --drift: no vstack repo found (checked \$VSTACK_DIR, ~/.config/agents/vstack-repo, ~/.vstack, and this script's git root)"
    echo "nothing was compared, so this is a failure rather than a pass"
    return 1
  }

  echo "comparing installed state against: $REPO"
  DRIFT=0
  COMPARED=0

  check_item() {
    rel="$1"; src="$2"; dst="$3"
    # Counted on entry, so "missing" and "differs" both count as compared. What this number is
    # for is the case below where it stays zero.
    COMPARED=$((COMPARED + 1))
    if [ ! -e "$dst" ]; then
      echo "missing   $rel  (not installed at $dst)"
      DRIFT=1
      return
    fi
    if [ -d "$src" ]; then
      # diff's exit status is read rather than inferred from its output. It returns 2 for
      # trouble (unreadable file, permissions) and this discarded stderr and counted the empty
      # output as zero changes, so a directory it could not read reported as clean.
      out=$(diff -rq "$src" "$dst" 2>&1); rc=$?
      if [ "$rc" -ge 2 ]; then
        echo "error     $rel  (diff failed, nothing compared: $(printf '%s' "$out" | head -1))"
        DRIFT=1
      elif [ -n "$out" ]; then
        echo "differs   $rel  ($(printf '%s\n' "$out" | grep -c .) change(s) vs $dst)"
        DRIFT=1
      fi
    else
      if ! diff -q "$src" "$dst" >/dev/null 2>&1; then
        echo "differs   $rel  (vs $dst)"
        DRIFT=1
      fi
    fi
  }

  # Every loop below is `[ -e "$f" ] || continue` guarded, which is correct for a glob that may
  # legitimately match nothing and wrong for one that must not. A $REPO that resolves but whose
  # claude/skills/ is empty -- a moved checkout, a partial clone, a stale vstack-repo pointer --
  # compared 28 installed skills against nothing and fell through to "no drift ✔". The resolve
  # failure above already learned this ("nothing to compare" is a failure, not a pass); the
  # loops under it had not.
  family_floor() { # <label> <count>
    [ "$2" -gt 0 ] && return 0
    echo "error     $1  (nothing to compare: $REPO ships none)"
    DRIFT=1
  }
  nfam=0

  for f in "$REPO"/claude/hooks/*.sh; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    check_item "claude/hooks/$b" "$f" "$CDIR/hooks/$b"
    nfam=$((nfam + 1))
  done
  family_floor "claude/hooks" "$nfam"; nfam=0
  for f in "$REPO"/claude/agents/*.md; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    check_item "claude/agents/$b" "$f" "$CDIR/agents/$b"
    nfam=$((nfam + 1))
  done
  family_floor "claude/agents" "$nfam"; nfam=0
  # Agent reference material. Its own family rather than folded into the loop above, because the
  # glob differs: *.ref, not *.md, and deliberately so -- Claude Code loads every .md under an
  # agent directory at any depth, so a reference named .md installs as a nameless agent. Shipped
  # in 1.45.0 and compared by nothing until 1.45.1: doctor said "no drift" over 74 items while
  # the file nine agent prompts point at could rot untouched.
  for f in "$REPO"/claude/agents/reference/*.ref; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    check_item "claude/agents/reference/$b" "$f" "$CDIR/agents/reference/$b"
    nfam=$((nfam + 1))
  done
  family_floor "claude/agents/reference" "$nfam"; nfam=0
  for f in "$REPO"/claude/commands/*.md; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    check_item "claude/commands/$b" "$f" "$CDIR/commands/$b"
    nfam=$((nfam + 1))
  done
  family_floor "claude/commands" "$nfam"; nfam=0
  for d in "$REPO"/claude/skills/*/; do
    [ -d "$d" ] || continue
    s=$(basename "$d")
    check_item "claude/skills/$s" "${d%/}" "$CDIR/skills/$s"
    nfam=$((nfam + 1))
  done
  family_floor "claude/skills" "$nfam"; nfam=0
  for f in "$REPO"/bin/*; do
    [ -e "$f" ] || continue
    b=$(basename "$f")
    check_item "bin/$b" "$f" "$HOME/.config/agents/bin/$b"
    nfam=$((nfam + 1))
  done
  family_floor "bin" "$nfam"; nfam=0
  # mcp servers. Merged into $CJSON's mcpServers map by install.sh, not copied byte-for-byte, so
  # this compares by key and value against the live merge target rather than diffing files the
  # way check_item does above. Until now, run_drift() never read mcp/servers.json at all -- a
  # server added, removed or edited here compared identical to baseline forever (confirmed by
  # tests/inventory-fixture.sh's mcp_servers row: a planted server, exit=0, compared=$COMPARED
  # unchanged). Same family_floor discipline as every glob above: an empty or missing
  # mcp/servers.json is a drift finding, not a silent zero.
  if [ -f "$REPO/mcp/servers.json" ] && command -v jq >/dev/null 2>&1; then
    mcp_want=$(sed "s|__HOME__|$HOME|g" "$REPO/mcp/servers.json")
    for m in $(printf '%s' "$mcp_want" | jq -r 'keys[]' 2>/dev/null); do
      nfam=$((nfam + 1))
      COMPARED=$((COMPARED + 1))
      if [ ! -f "$CJSON" ]; then
        echo "missing   mcp/servers.json:$m  (not installed at $CJSON)"
        DRIFT=1
        continue
      fi
      w=$(printf '%s' "$mcp_want" | jq -cS --arg m "$m" '.[$m]' 2>/dev/null)
      h_raw=$(jq -cS --arg m "$m" '.mcpServers[$m] // empty' "$CJSON" 2>/dev/null)
      if [ -z "$h_raw" ] || [ "$h_raw" = "null" ]; then
        echo "missing   mcp/servers.json:$m  (not registered in $CJSON)"
        DRIFT=1
      else
        # Compare only the keys this repo declares. install.sh MERGES into an existing
        # mcpServers map rather than overwriting it, and the merge target legitimately carries
        # keys the repo never stated -- Claude Code writes `"env": {}` into every entry it
        # registers, so a byte-equal comparison reported `differs` for context7 on every machine
        # where the installer had ever run. A check that is red on a correct install is the same
        # defect as one that is green on a broken one; it just fails in the direction that gets
        # it ignored rather than trusted.
        #
        # Declared key missing from the installed entry, or present with a different value, is
        # still drift. Extra keys belong to the merge target and are not this repo's business.
        wk=$(printf '%s' "$w" | jq -c 'keys' 2>/dev/null)
        h=$(printf '%s' "$h_raw" | jq -cS --argjson k "$wk" 'with_entries(select(.key as $x | $k | index($x)))' 2>/dev/null)
        if [ "$h" != "$w" ]; then
          echo "differs   mcp/servers.json:$m  (declared keys: $h vs wanted $w, in $CJSON)"
          DRIFT=1
        fi
      fi
    done
    family_floor "mcp/servers.json" "$nfam"; nfam=0
  elif [ -f "$REPO/mcp/servers.json" ]; then
    echo "error     mcp/servers.json  (jq not found, cannot compare)"
    DRIFT=1
  else
    family_floor "mcp/servers.json" "0"
  fi
  # install.sh calls CLAUDE.md "the file most likely to have been hand-edited on a machine that
  # has been running a while", and it was the one file --drift never looked at. Hand-edit it,
  # get "no drift", then lose the edit on the next update. Same for the statusline and the
  # shell lane.
  check_item "claude/CLAUDE.md"        "$REPO/claude/CLAUDE.md"        "$CDIR/CLAUDE.md"
  check_item "claude/statusline.sh"    "$REPO/claude/statusline.sh"    "$CDIR/statusline.sh"
  [ -f "$REPO/conductor/settings.managed.toml" ] && \
    check_item "conductor/settings.managed.toml" "$REPO/conductor/settings.managed.toml" "$HOME/.conductor/settings.managed.toml"
  [ -f "$REPO/shell/claude-parity.zsh" ] && \
    check_item "shell/claude-parity.zsh" "$REPO/shell/claude-parity.zsh" "$HOME/.config/agents/shell/claude-parity.zsh"

  # --- settings.json keys -------------------------------------------------------------------
  # The two blind spots below are why this whole section exists. --drift compared files it
  # could diff byte-for-byte and quietly skipped the two surfaces that cannot be compared that
  # way, so both rotted for months while it printed "no drift".
  #
  # First: ~/.claude/settings.json is a MERGE, never a copy, so it can never be diffed against
  # the repo. install.sh had no way to delete, which meant every key vstack ever shipped and
  # later dropped stayed in the live file forever. It happened twice. install.sh owns deletion
  # now (see RETIRED there), but that only strips keys someone remembered to list, so this
  # reads the live file back and names anything the repo does not ship.
  #
  # USER_SCOPE keys legitimately exist only on a machine: they are per-account or per-device
  # and have no business in a public repo. Anything outside both sets is unclassified — not
  # necessarily wrong, but nobody has decided what it is, which is exactly the state the dead
  # skillOverrides and sandbox blocks sat in.
  if command -v jq >/dev/null 2>&1 && [ -f "$CDIR/settings.json" ]; then
    # Claude Code's own settings belong here even though vstack never writes them. Leaving one
    # out pushes the reader toward the wrong remedy: doctor offers "ship it" or "retire it", and
    # retiring a key Claude Code owns means install.sh deletes a working feature. `sandbox` is
    # the cautionary one — it configures native Bash sandboxing, and it was very nearly added to
    # install.sh's RETIRED list on exactly this reasoning.
    USER_SCOPE='["forceLoginMethod","remote","enabledPlugins","extraKnownMarketplaces","preferredNotifChannel","permissions","skipDangerousModePermissionPrompt","statusLine","hooks","feedbackSurveyState","hasCompletedOnboarding","lastOnboardingVersion","userID","oauthAccount","customApiKeyResponses","tipsHistory","promptQueueUseCount","installMethod","autoUpdates","theme","sandbox","autoCompactEnabled","enabledMcpjsonServers","mcpServers","alwaysThinkingEnabled","includeCoAuthoredBy","attributionSettings","autoMode","editorMode","verbose"]'
    extra=$(jq -r --slurpfile repo "$REPO/claude/settings.json" --argjson us "$USER_SCOPE" '
      ($repo[0] | keys) as $shipped
      | keys - $shipped - $us
      | .[]' "$CDIR/settings.json" 2>/dev/null)
    if [ -n "$extra" ]; then
      echo "unclassified settings.json key(s) not shipped by the repo and not user-scope:"
      printf '          %s\n' $extra
      echo "          decide each one: add it to claude/settings.json, to RETIRED in install.sh, or to USER_SCOPE here"
      DRIFT=1
    fi
  fi

  # --- files the repo never shipped -----------------------------------------------------------
  # Second blind spot: --drift only ever walked repo -> machine, so it could see a file that
  # went missing and never a file that should not be there. A deleted orchestrate.md survived
  # in ~/.claude for months that way, and a pre-vstack bootstrap-claude-project.sh sat in
  # ~/.claude/scripts propping up a command that was broken for everyone else on earth.
  #
  # Reports only; never deletes. These are the user's files, and a health check that removes
  # things you did not ask it to remove is worse than the drift.
  #
  # Symlinks are skipped on purpose: plugin- and Claude-Code-bundled skills (skill-creator,
  # pdf, docx, pptx, xlsx) link in from elsewhere and are expected.
  RUNTIME_TOP='projects sessions session-env shell-snapshots tasks todos plans telemetry plugins cache chrome daemon downloads paste-cache jobs ide statsig backups scheduled-tasks history.jsonl stats-cache.json mcp-needs-auth-cache.json settings.json settings.local.json .credentials.json .last-update-result.json .last-cleanup .cc-writes CLAUDE.md statusline.sh hooks agents commands skills'
  # Everything above is Claude Code's own. vstack's hooks write log files into the same
  # directory, and those were landing in the "presumed yours" bucket -- doctor telling the
  # operator that vstack's own output might be a stranger's leftover. Derived from the shipped
  # hooks rather than listed by hand, because the replay log was added in 1.43.0 and a hand-kept
  # list would have gone stale that same afternoon. If a hook writes it, doctor knows it.
  for _rt in "$REPO"/claude/hooks/*.sh; do
    [ -e "$_rt" ] || continue
    _rtn=$(grep -ohE 'vstack-[a-z-]+\.jsonl' "$_rt" 2>/dev/null | sort -u | tr '\n' ' ')
    [ -n "$_rtn" ] && RUNTIME_TOP="$RUNTIME_TOP $_rtn"
  done
  stale=""
  for p in "$CDIR"/* "$CDIR"/.[!.]*; do
    [ -e "$p" ] || continue
    b=$(basename "$p")
    case " $RUNTIME_TOP " in *" $b "*) continue ;; esac
    stale="$stale $b"
  done
  for kind in hooks:'*.sh' agents:'*.md' commands:'*.md' agents/reference:'*.ref'; do
    d=${kind%%:*}; pat=${kind#*:}
    for p in "$CDIR"/"$d"/$pat; do
      [ -e "$p" ] || continue
      [ -L "$p" ] && continue
      b=$(basename "$p")
      [ -e "$REPO/claude/$d/$b" ] || stale="$stale $d/$b"
    done
  done
  for p in "$CDIR"/skills/*/; do
    [ -d "$p" ] || continue
    s=$(basename "$p")
    [ -L "${p%/}" ] && continue
    [ -d "$REPO/claude/skills/$s" ] || stale="$stale skills/$s"
  done
  # Two very different things end up in that list, and calling both "drift" would be wrong.
  # A file the repo USED to ship and later deleted is a genuine leftover: the deletion never
  # reached this machine, which is precisely how orchestrate.md outlived its removal. A file
  # the repo has never had at any commit is the user's own, and a health check has no standing
  # to call that an error. Git history is what separates them, so ask it instead of guessing.
  if [ -n "$stale" ]; then
    leftover=""; theirs=""
    for b in $stale; do
      case "$b" in
        hooks/*|agents/*|commands/*|skills/*) rel="claude/$b" ;;
        *)                                    rel="claude/$b" ;;
      esac
      # Two traps here, both of which produced a confidently wrong answer:
      #
      # `git log`, not `rev-list --objects`. The latter accepts a pathspec but still walks every
      # reachable object, so it says "yes" for a path that has never existed and files all of
      # the user's own files under "the repo dropped this".
      #
      # And capture the output rather than piping into `grep -q`. Under `set -o pipefail` grep
      # exits the moment it matches, git takes SIGPIPE, and the pipeline reports 141 — on a
      # match. Piping inverted the test: every leftover was classified as the user's own file.
      hist=$(git -C "$REPO" log --all --oneline -- "$rel" 2>/dev/null)
      if [ -n "$hist" ]; then
        leftover="$leftover $b"
      else
        theirs="$theirs $b"
      fi
    done
    if [ -n "$leftover" ]; then
      echo "left over from a version this repo used to ship (the delete never reached this machine):"
      printf '          %s\n' $leftover
      echo "          safe to remove — git history shows the repo dropped them"
      DRIFT=1
    fi
    if [ -n "$theirs" ]; then
      echo "note: in ~/.claude but never shipped by this repo, so presumed yours:"
      printf '          %s\n' $theirs
    fi
  fi

  # Behind-remote is informational only — never fail solely for being behind.
  #
  # Every flag here is spelled out because a bare `git fetch` is not read-only: it does whatever
  # the operator's ~/.gitconfig says. With fetch.prune and fetch.pruneTags set true -- a common
  # pairing -- it deletes every local tag and remote-tracking branch that is not on the remote.
  # That is exactly what happened during the 1.9.1 audit: `doctor --drift`, a command whose whole
  # job is to compare and report, silently destroyed an unpushed release tag, and the release
  # check then reported ok for a version whose tag had been deleted out from under it seconds
  # earlier. An inspection command must not be able to change what it inspects, whatever the
  # ambient config says.
  if git -C "$REPO" rev-parse --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$REPO" fetch -q --no-tags --no-prune --no-write-fetch-head 2>/dev/null || true
    behind=$(git -C "$REPO" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
    case "$behind" in ''|*[!0-9]*) behind=0 ;; esac
    if [ "$behind" -gt 0 ]; then
      echo "note: repo is $behind commit(s) behind its remote (git -C \"$REPO\" pull)"
    fi
  fi

  echo
  if [ "$DRIFT" = 1 ]; then
    echo "DRIFT ✖"
    return 1
  fi
  # A comparison that does not say what it compared cannot be audited, and one that compared
  # nothing must not print the same word as one that compared everything.
  if [ "$COMPARED" -eq 0 ]; then
    echo "nothing was compared, so this is a failure rather than a pass"
    echo "DRIFT ✖"
    return 1
  fi
  echo "no drift ✔ ($COMPARED item(s) compared)"
  return 0
}

# --- argument dispatch -------------------------------------------------------------------
# One recognized flag in $1, nothing after it. Unrecognized flags and stray extra arguments
# are a usage error, not a thing to guess about and run the full audit anyway -- a typo'd
# `--dirft` silently running the wrong (or default) mode is worse than a loud, cheap exit 2.
case "${1:-}" in
  -h|--help)
    # No audit: this branch exits before resolve_vstack_repo, run_drift, or any of the ok/bad/
    # note checks below ever run. `doctor --help` costs nothing but printing this text.
    cat <<'EOF'
usage: doctor [--drift | --json | --mcp | --help]

  (no flags)   full human-readable health audit of this machine's vstack install
  --drift      compare the installed state against the vstack repo checkout it came from
  --json       machine-readable audit (schemaVersion 1): version, install lane, profile,
               drift, trust state, dependencies, last verification, checks, skips, exit
               code. Requires jq; fails naming jq if jq is not on PATH.
  --mcp        (combine with no other flag) also list configured MCP servers and their
               connection state
  -h, --help   show this help and exit; performs no audit

exit codes:
  0  healthy — no drift, no failing checks (or --help printed)
  1  drift found, or one or more checks failed
  2  usage error — unknown flag or unexpected extra argument
  3  could not measure — a hard dependency for the requested mode is missing
     (e.g. --json without jq on PATH)
EOF
    exit 0
    ;;
  ""|--drift|--json|--mcp)
    ;;
  *)
    echo "doctor: unknown argument: ${1:-}" >&2
    echo "usage: doctor [--drift | --json | --mcp | --help]" >&2
    exit 2
    ;;
esac
if [ "$#" -gt 1 ]; then
  echo "doctor: unexpected extra argument(s) after '$1'" >&2
  echo "usage: doctor [--drift | --json | --mcp | --help]" >&2
  exit 2
fi

if [ "${1:-}" = "--drift" ]; then
  run_drift
  exit $?
fi

# --json requires jq for the entire run: every field below (settings-key diffing, plugin.json
# version, gh/CI parsing, the drift family checks) already assumes it deep inside the checks
# that follow, so a jq-less run would not degrade gracefully into a smaller-but-valid document —
# it would degrade into malformed or half-populated JSON, which the caller cannot tell apart from
# a real report. Fail loud and name the missing binary instead: exit 3, "could not measure",
# not a JSON body claiming to have measured something it didn't.
JSON_MODE=0
if [ "${1:-}" = "--json" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "doctor --json: requires jq, not found on PATH (brew install jq / apt install jq)" >&2
    exit 3
  fi
  JSON_MODE=1
fi

# section(): every "── heading ──" below both prints (as it always did) and, in --json mode,
# tags every ok/bad/note call until the next heading with the category it belongs to.
CURRENT_CATEGORY="general"
section(){ echo "── $1 ──"; CURRENT_CATEGORY="$1"; }

# json_row(): the one place ok/bad/note feed --json's `checks` and `skips` arrays, so the two
# output shapes can never see a different set of results -- same functions, same call sites,
# same verdicts, formatted twice. jq builds each object so label/detail text (paths, error
# messages) gets JSON-escaped instead of hand-quoted.
JSON_ROWS=""
json_row(){ # label status detail
  [ "$JSON_MODE" = 1 ] || return 0
  JSON_ROWS="${JSON_ROWS}$(jq -nc --arg cat "$CURRENT_CATEGORY" --arg label "$1" --arg status "$2" --arg detail "${3:-}" \
    '{category:$cat,label:$label,status:$status,detail:$detail}')
"
}

p(){ printf "%-40s %s\n" "$1" "$2"; }
ok(){ p "$1" "✔"; json_row "$1" "ok" ""; }
bad(){ p "$1" "✖ $2"; FAIL=1; json_row "$1" "bad" "$2"; }
FAIL=0

# Not every line below is vstack's to be right about. A stranger's Claude plan, their directory
# layout, and which optional plugins they installed are theirs, and reporting DRIFT over them
# made a clean install look broken -- eight red lines that no re-run could ever fix. `note` says
# the same thing without claiming the setup is wrong. What stays a hard failure is only what
# vstack itself installs and can therefore be held to.
note(){ p "$1" "· $2"; json_row "$1" "note" "$2"; }

# Bounds a command's wall time without assuming GNU coreutils' `timeout` is installed. Stock
# macOS ships neither `timeout` nor `gtimeout` -- only `brew install coreutils` adds the latter
# -- so a network call left unbounded (e.g. `git ls-remote` against a blackholed remote) hangs
# for the underlying transport's own connect timeout, 75+ seconds for git-over-http. That is
# doctor's problem specifically because install.sh runs doctor unconditionally at the end, so a
# new user's very first command looks hung for over a minute with no feedback.
run_with_timeout(){
  _rwt_secs="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_rwt_secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_rwt_secs" "$@"
  else
    # Manual fallback: background the real command, race it against a sleeping watcher that
    # SIGTERMs it if it's still alive when the clock runs out, then reap both so no zombie or
    # orphaned sleep survives doctor's own exit.
    #
    # `set -m` (job control) is load-bearing, not decoration: `git ls-remote` over http forks a
    # `git-remote-http` helper that inherits our fd 1, and that helper is still blocked in
    # connect() to the blackholed remote when TERM is sent to only the direct child. It becomes
    # an orphan that keeps fd 1 open, and the `_out=$(...)` capturing our output then blocks
    # waiting for EOF on that fd for the remote's own 75s timeout regardless of the child we
    # actually killed. Job control gives the backgrounded job its own process group, so
    # `kill -- "-$pid"` (negative pid = the group) reaches the helper too.
    (
      set -m
      "$@" &
      _rwt_cpid=$!
      ( sleep "$_rwt_secs"; kill -TERM -- "-$_rwt_cpid" 2>/dev/null ) &
      _rwt_wpid=$!
      wait "$_rwt_cpid" 2>/dev/null; _rwt_rc=$?
      kill "$_rwt_wpid" 2>/dev/null; wait "$_rwt_wpid" 2>/dev/null
      exit "$_rwt_rc"
    )
  fi
}

get_perms(){
  if [ "$(/usr/bin/uname -s 2>/dev/null || uname -s 2>/dev/null)" = "Darwin" ]; then
    stat -f '%Lp' "$1" 2>/dev/null
  else
    stat -c '%a' "$1" 2>/dev/null
  fi
}

# Expectations come from the repo when it can be found, so adding a hook or an agent does not
# need a matching edit here. This used to fall back to a hardcoded HOOKS list and WANT_AGENTS=6
# when no repo could be resolved, and both had already fallen behind the tree (4 of 7 hooks, 6
# of 14 agents) -- a constant that goes stale is a check with no second opinion asserting itself
# as if it had one. Both cases below now DECLINE TO ASSERT with no repo to compare against,
# instead of asserting a number that is only ever accurate by coincidence. HOOKS="" and
# WANT_AGENTS="" are the "no repo resolved" signal the two call sites branch on.
R=$(resolve_vstack_repo 2>/dev/null) || R=""
HOOKS=""
WANT_AGENTS=""
if [ -n "$R" ]; then
  h=$(ls "$R"/claude/hooks/*.sh 2>/dev/null | while read -r f; do basename "$f" .sh; done | tr '\n' ' ')
  [ -n "$h" ] && HOOKS="$h"
  a=$(ls "$R"/claude/agents/*.md 2>/dev/null | wc -l | tr -d ' ')
  [ "${a:-0}" -gt 0 ] && WANT_AGENTS="$a"
fi

# vstack's own declared version, read from the repo's plugin manifest -- the same source
# release-reachability (below) already trusts for "$_rv". Not asserted against anything here;
# --json just reports what this checkout says it is. Empty (never absent) so a missing repo and
# a repo whose manifest doesn't parse both come out as "" and get turned into JSON null the same
# way at assembly time.
VSTACK_VERSION=""
[ -n "$R" ] && command -v jq >/dev/null 2>&1 && \
  VSTACK_VERSION=$(jq -r '.version // empty' "$R/claude/.claude-plugin/plugin.json" 2>/dev/null)

# Trust state: is *this* checkout's .claude/verify.sh the one install.sh last recorded consent
# for in ~/.config/agents/verify-trust (see install.sh's own comment on why that file exists --
# running install.sh IS the explicit consent, and the Stop-hook gate refuses to run repo-controlled
# code it was never told to trust). Three answers, not two: "trusted" and "untrusted" are both
# things this machine can prove; "unknown" is reserved for when there's nothing to check against
# (no repo resolved, no verify.sh in it, or no shasum/sha256sum to hash it with) -- an absent
# dependency must read as unknown, never silently as either verdict.
TRUST_STATE="unknown"; TRUST_DETAIL="no vstack repo found"
if [ -n "$R" ]; then
  if [ -f "$R/.claude/verify.sh" ]; then
    _tvp="$(cd "$R/.claude" 2>/dev/null && pwd)/verify.sh"
    if command -v shasum >/dev/null 2>&1; then _th=$(shasum -a 256 "$_tvp" 2>/dev/null | cut -d' ' -f1)
    elif command -v sha256sum >/dev/null 2>&1; then _th=$(sha256sum "$_tvp" 2>/dev/null | cut -d' ' -f1)
    else _th=""; fi
    _tf="$HOME/.config/agents/verify-trust"
    if [ -z "$_th" ]; then
      TRUST_DETAIL="no shasum/sha256sum on PATH -- could not hash $_tvp"
    elif [ ! -f "$_tf" ]; then
      TRUST_STATE="untrusted"; TRUST_DETAIL="$_tf does not exist -- the verify-gate has never been armed for this checkout"
    elif grep -qF "$_th  $_tvp" "$_tf" 2>/dev/null; then
      TRUST_STATE="trusted"; TRUST_DETAIL="$_tvp hash matches $_tf (recorded by install.sh)"
    else
      TRUST_STATE="untrusted"; TRUST_DETAIL="$_tvp not recorded in $_tf at its current hash -- stale trust, or install.sh has not run from here"
    fi
  else
    TRUST_DETAIL="$R/.claude/verify.sh does not exist in this checkout"
  fi
fi

# Dependencies: the external tools doctor's own checks reach for. Every skip below (CI skipped
# for no gh, MCP-registration skipped for no jq, and so on) traces back to one of these being
# absent, so --json names them once as their own field instead of making the reader re-derive
# "well *why* was that a skip" from free-text detail strings.
DEP_JQ=false;      command -v jq      >/dev/null 2>&1 && DEP_JQ=true
DEP_GIT=false;     command -v git     >/dev/null 2>&1 && DEP_GIT=true
DEP_GH=false;      command -v gh      >/dev/null 2>&1 && DEP_GH=true
DEP_CLAUDE=false;  command -v claude  >/dev/null 2>&1 && DEP_CLAUDE=true
DEP_TIMEOUT=false; { command -v timeout >/dev/null 2>&1 || command -v gtimeout >/dev/null 2>&1; } && DEP_TIMEOUT=true

# Last verification: nothing install.sh writes and nothing bin/doctor writes records when doctor
# last ran clean. The one thing on THIS machine that does is ~/.config/agents/doctor.log, appended
# to by ~/.config/agents/bin/doctor-cron.sh via a crontab entry -- neither of which vstack ships or
# install.sh creates; it is this operator's own scheduled-task setup. Reported best-effort, and
# labeled as exactly that, rather than invented as though it were a guarantee this repo makes.
LV_AVAILABLE=false; LV_TS=""; LV_SRC=""
_lv="$HOME/.config/agents/doctor.log"
if [ -f "$_lv" ]; then
  LV_AVAILABLE=true
  LV_SRC="$_lv (appended to by a crontab-run doctor-cron.sh -- not shipped or created by vstack itself)"
  if [ "$(/usr/bin/uname -s 2>/dev/null || uname -s 2>/dev/null)" = "Darwin" ]; then
    LV_TS=$(stat -f '%Sm' -t '%Y-%m-%dT%H:%M:%S%z' "$_lv" 2>/dev/null)
  else
    _lve=$(stat -c '%Y' "$_lv" 2>/dev/null)
    [ -n "$_lve" ] && LV_TS=$(date -d @"$_lve" '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null)
  fi
fi

# Drift, for --json: the exact same run_drift() `--drift` alone calls, so the two output shapes
# can never disagree about whether this machine has drifted. Output goes to a temp file rather
# than a `$(...)` capture on purpose -- capturing would fork a subshell, and DRIFT/COMPARED are
# plain globals run_drift sets by side effect; a subshell's copy of them dies with the subshell
# and --json would read back whatever they were before the call. In non-JSON mode this whole
# block is skipped entirely: the plain audit below has never called run_drift and still doesn't.
DRIFT_STATUS="ok"; DRIFT_COMPARED=0; DRIFT_DETAIL=""
if [ "$JSON_MODE" = 1 ]; then
  _drift_tmp=$(mktemp)
  run_drift >"$_drift_tmp" 2>&1
  _drift_rc=$?
  # The founding defect this file was fixed for once already, restated as a floor here: a run
  # that compared zero items can never report "ok", no matter what its exit code was.
  if [ "$_drift_rc" -eq 0 ] && [ "${COMPARED:-0}" -gt 0 ]; then
    DRIFT_STATUS="ok"; DRIFT_COMPARED="$COMPARED"
    DRIFT_DETAIL="no drift ($COMPARED item(s) compared)"
  elif [ "${COMPARED:-0}" -eq 0 ]; then
    DRIFT_STATUS="error"; DRIFT_COMPARED=0
    DRIFT_DETAIL=$(grep -m1 . "$_drift_tmp" 2>/dev/null)
    [ -n "$DRIFT_DETAIL" ] || DRIFT_DETAIL="nothing was compared"
  else
    DRIFT_STATUS="drift"; DRIFT_COMPARED="$COMPARED"
    DRIFT_DETAIL="drift found across $COMPARED item(s) compared -- run 'doctor --drift' for the file-by-file report"
  fi
  rm -f "$_drift_tmp"
fi

# Everything from here down is the plain, human-readable audit, unchanged. In --json mode its
# stdout is swapped to /dev/null (fd 4 holds the real stdout) so it still runs -- every ok/bad/
# note call still fires and still feeds json_row -- but only the JSON document at the very
# bottom reaches the terminal. `doctor --json | jq -e .` must see exactly one JSON value, never
# this section's banners interleaved with it.
if [ "$JSON_MODE" = 1 ]; then exec 4>&1 1>/dev/null; fi

# Two install lanes put the payload in two different places, and everything below this point
# used to assume only one of them: the full ~/.claude layout install.sh writes. A plugin-only
# install (`claude plugin install vstack@vstack`) never runs install.sh, so $CDIR/hooks,
# $CDIR/agents and $CDIR/skills stay empty on a perfectly healthy install -- every check below
# reported that as failure, telling a stranger their working install was broken. Detect which
# lane actually landed before asserting anything is missing.
PLUGIN_ROOT=""
if [ ! -d "$CDIR/skills" ] || [ -z "$(ls -A "$CDIR/skills" 2>/dev/null)" ]; then
  # installed_plugins.json names the exact path Claude Code installed to; prefer it over
  # globbing, since it can't be confused by a stale directory an old version left behind.
  IPJ="$CDIR/plugins/installed_plugins.json"
  if command -v jq >/dev/null 2>&1 && [ -f "$IPJ" ]; then
    PLUGIN_ROOT=$(jq -r '.plugins["vstack@vstack"][0].installPath // empty' "$IPJ" 2>/dev/null)
    [ -n "$PLUGIN_ROOT" ] && [ -d "$PLUGIN_ROOT" ] || PLUGIN_ROOT=""
  fi
  if [ -z "$PLUGIN_ROOT" ]; then
    # Fall back to the newest cache directory by mtime rather than a hardcoded version -- the
    # version in this path changes every release. Not sorted by version number either: BSD
    # sort has no -V, and a plain string sort puts 1.9.0 above 1.10.0 (see tests/README.md).
    PLUGIN_ROOT=$(ls -dt "$CDIR"/plugins/cache/vstack/vstack/*/ 2>/dev/null | head -1)
    PLUGIN_ROOT="${PLUGIN_ROOT%/}"
  fi
  [ -n "$PLUGIN_ROOT" ] && [ -d "$PLUGIN_ROOT/skills" ] || PLUGIN_ROOT=""
fi
FULL_LIVE=0
[ -d "$CDIR/skills" ] && [ -n "$(ls -A "$CDIR/skills" 2>/dev/null)" ] && FULL_LIVE=1

section "install"
if [ "$FULL_LIVE" -eq 1 ]; then
  p "lane" "full ($CDIR)"
elif [ -n "$PLUGIN_ROOT" ]; then
  p "lane" "plugin ($PLUGIN_ROOT)"
else
  bad "lane" "no vstack install found -- neither $CDIR/skills nor $CDIR/plugins/cache/vstack/vstack/*/skills exists (claude plugin marketplace add itsvedantkumar/vstack && claude plugin install vstack@vstack, or git clone + ./install.sh)"
fi

section "skills / agents / commands"
if [ "$FULL_LIVE" -eq 1 ]; then
  SK_DIR="$CDIR/skills"; AG_DIR="$CDIR/agents"; CM_DIR="$CDIR/commands"
elif [ -n "$PLUGIN_ROOT" ]; then
  SK_DIR="$PLUGIN_ROOT/skills"; AG_DIR="$PLUGIN_ROOT/agents"; CM_DIR="$PLUGIN_ROOT/commands"
else
  SK_DIR=""; AG_DIR=""; CM_DIR=""
fi
if [ -n "$SK_DIR" ]; then
  nsk=$(ls -d "$SK_DIR"/*/ 2>/dev/null | wc -l | tr -d ' ')
  nag=$(ls "$AG_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ')
  ncm=$(ls "$CM_DIR"/*.md 2>/dev/null | wc -l | tr -d ' ')
  [ "${nsk:-0}" -gt 0 ] && ok "skills ($nsk)" || bad "skills" "none found in $SK_DIR"
  if [ -n "$WANT_AGENTS" ]; then
    [ "${nag:-0}" -ge "$WANT_AGENTS" ] && ok "subagents ($nag)" || bad "subagents" "$nag<$WANT_AGENTS"
  else
    note "subagents ($nag)" "no vstack repo found to compare against -- cannot assert a minimum, only report the count"
  fi
  [ "${ncm:-0}" -gt 0 ] && ok "commands ($ncm)" || bad "commands" "none found in $CM_DIR"
else
  note "skills / agents / commands" "no install found, nothing to count"
fi

section "hooks"
if [ "$FULL_LIVE" -eq 1 ]; then
  # inject-orchestrator + inject-tokenmaxxing were merged into inject-session-context (2026-08-10)
  if [ -n "$HOOKS" ]; then
    for f in $HOOKS; do
      [ -x "$CDIR/hooks/$f.sh" ] && ok "$f.sh" || bad "$f.sh" "missing/not exec"; done
  else
    note "hooks" "no vstack repo found to compare against -- cannot enumerate which hook scripts should exist"
  fi
  [ -x "$HOME/.config/agents/bin/claude-bg.sh" ] && ok "claude-bg.sh (headless)" || bad "claude-bg.sh" "missing"
  # bin/claude-task.sh ships in the same sweep (install.sh copies bin/* wholesale) and nothing in
  # the repository named it, so nothing checked it either -- it was installed on every machine and
  # findable from none. It is the scheduled-task runner cron drives.
  [ -x "$HOME/.config/agents/bin/claude-task.sh" ] && ok "claude-task.sh (scheduled runs)" || bad "claude-task.sh" "missing"
elif [ -n "$PLUGIN_ROOT" ]; then
  # As of c842cc2 the plugin lane DOES wire hooks -- claude/hooks/hooks.json auto-discovers into
  # it, SessionStart + Stop routing only (inject-session-context.sh, skill-mandate.sh). README's
  # component table and .claude/verify.sh check 47 both know this; this note used to be the one
  # place left still claiming the lane installed zero. verify.sh check 48 asserts this note does
  # not regress by cross-checking it against claude/inventory.json's profiles.plugin.ships.
  note "hooks" "2 routing hooks via claude/hooks/hooks.json (SessionStart + Stop) -- no verify-gate.sh, no shell lane, no CLI wrappers; take the full install for those"
else
  note "hooks" "no install found, nothing to check"
fi
section "secrets"
if [ "$FULL_LIVE" -eq 1 ]; then
  [ -f "$HOME/.config/agents/secrets.env" ] && [ "$(get_perms "$HOME/.config/agents/secrets.env")" = "600" ] && ok "secrets.env (600)" || bad "secrets.env" "missing/perms"
  # Asserts the opposite of what it used to. Sourcing secrets.env from a shell rc exports every
  # credential to every child process of every shell; the wrappers in bin/ load what they need
  # themselves. An install that puts it back is a regression, so this fails on finding it.
  # Two different things can put this line in an rc file, and they deserve different answers.
  # The `set -a` form is the one install.sh used to write: if it is back, that is a regression in
  # this repo and it fails. Any other spelling is a line the user wrote themselves — still a real
  # exposure worth naming, but not this tool's to fail over or to delete.
  _amb_ours=""; _amb_theirs=""
  for _rc in .zshenv .zshrc .bashrc .profile; do
    [ -f "$HOME/$_rc" ] || continue
    if grep -q 'set -a && \. "$HOME/.config/agents/secrets.env" && set +a' "$HOME/$_rc" 2>/dev/null; then
      _amb_ours="$_amb_ours $_rc"
    elif grep -q 'agents/secrets.env' "$HOME/$_rc" 2>/dev/null; then
      _amb_theirs="$_amb_theirs $_rc"
    fi
  done
  if [ -n "$_amb_ours" ]; then
    bad "credentials exported to shells" "vstack's own export is back in:$_amb_ours — re-run ./install.sh, which removes it"
  else
    ok "vstack exports no credentials to shells"
  fi
  [ -n "$_amb_theirs" ] && p "your own secrets sourcing" "note:$_amb_theirs sources secrets.env, so every child process of those shells sees your tokens. The wrappers in ~/.config/agents/bin load what they need on their own, so this line is probably not needed."
  [ -x "$HOME/.config/agents/bin/cloudflare-mcp" ] && ok "wrapper cloudflare-mcp" || bad "wrapper cloudflare-mcp" "missing"
elif [ -n "$PLUGIN_ROOT" ]; then
  note "secrets / wrappers" "not part of the plugin lane by design -- take the full install for secrets.env and the CLI wrappers"
else
  note "secrets / wrappers" "no install found, nothing to check"
fi
section "mcp servers"
# CJSON was computed at the top of this file and never read by anything. install.sh merges
# vstack's MCP servers into it on every run and nothing checked the result, so the one lane that
# writes to a file outside ~/.claude had no health check at all. A server that silently stopped
# being registered would show up as a tool that quietly does not exist.
#
# The plugin lane merges none: claude/.claude-plugin/plugin.json declares no mcpServers key, so
# a plugin-only install has zero registered by design -- not drift, and not this file's to fail.
if [ "$FULL_LIVE" -eq 0 ] && [ -n "$PLUGIN_ROOT" ]; then
  note "MCP servers" "0 via the plugin lane (claude/.claude-plugin/plugin.json declares no mcpServers) -- take the full install to get them merged into $CJSON"
elif [ -n "$R" ] && [ -f "$R/mcp/servers.json" ] && [ -f "$CJSON" ]; then
  missing=""
  for m in $(jq -r 'keys[]' "$R/mcp/servers.json" 2>/dev/null); do
    jq -e --arg m "$m" '.mcpServers | has($m)' "$CJSON" >/dev/null 2>&1 || missing="$missing $m"
  done
  [ -z "$missing" ] \
    && ok "MCP servers registered ($(jq -r 'keys|length' "$R/mcp/servers.json") in $CJSON)" \
    || bad "MCP servers" "not registered in $CJSON:$missing (re-run ./install.sh)"
elif [ ! -f "$CJSON" ]; then
  note "MCP servers" "$CJSON does not exist yet — Claude Code creates it on first run"
else
  note "MCP servers" "no vstack repo found, so there is nothing to compare against"
fi
section "deploy"
if [ "$FULL_LIVE" -eq 1 ]; then
  [ -x "$HOME/.config/agents/bin/deploy-auto.sh" ] && ok "deploy-auto.sh" || bad "deploy-auto.sh" "missing"
elif [ -n "$PLUGIN_ROOT" ]; then
  note "deploy-auto.sh" "not part of the plugin lane by design -- take the full install for the CLI wrappers"
else
  note "deploy-auto.sh" "no install found, nothing to check"
fi
S="$CDIR/settings.json"
section "parity"
[ -z "${ANTHROPIC_API_KEY:-}" ] && ok "no ANTHROPIC_API_KEY in env" || bad "ANTHROPIC_API_KEY" "set — billing API credits, not the Max sub"
AS=$(claude auth status 2>/dev/null)
# NB: there is no `apiKeySource` field in 2.1.226 — `jq '{apiKeySource}'` renders a missing
# key as null, which looks like a pass but proves nothing. authMethod+apiProvider are real.
# The plan is the user's. vstack's actual claim is narrower and is asserted right below: that
# you are not silently paying per-token when you meant to use a subscription.
sub=$(printf '%s' "$AS" | jq -r '.subscriptionType // "unknown"' 2>/dev/null)
printf '%s' "$AS" | jq -e '.loggedIn == false' >/dev/null 2>&1 && sub="signed-out"
case "$sub" in
  max)        ok   "auth: Max subscription" ;;
  signed-out) note "auth: plan" "not signed in yet — run 'claude login'" ;;
  unknown)    note "auth: plan" "could not read subscriptionType (claude auth status gave nothing)" ;;
  *)       note "auth: plan" "$sub — vstack works on any plan; Max is what its defaults were tuned against" ;;
esac
# Three states, not two. A machine that has never run `claude login` returns nothing here, and
# reading nothing as "not OAuth" told every fresh install it might be burning API credits -- a
# red line about billing on a setup that has not made a single request. Absence of an answer is
# not an answer.
# The CLI answers `{"loggedIn": false, "authMethod": "none"}` rather than staying silent, so
# emptiness is not the signal -- loggedIn is.
if [ -z "$AS" ] || printf '%s' "$AS" | jq -e '.loggedIn == false' >/dev/null 2>&1; then
  note "auth method" "not signed in yet — run 'claude login' (nothing to check until then)"
elif printf '%s' "$AS" | jq -e '.authMethod=="claude.ai" and .apiProvider=="firstParty"' >/dev/null 2>&1; then
  ok "auth: claude.ai OAuth (not API key)"
else
  bad "auth method" "not OAuth — may be billing API credits"
fi
# Two claims, and only the first is vstack's. It ships forceLoginMethod in settings.json, which
# is checkable on any machine. Whether the CLI is *enforcing* it can only be read from a signed-in
# session, so on CI and on any fresh install this asked a question with no answer available and
# read the silence as a failure.
#
# forceLoginMethod, the parity keys, context caps and the claude-parity.zsh wrapper are all
# written by install.sh's settings merge -- the plugin lane never runs it, so $S never carries
# them there. That is the install.sh-only lane doing exactly what it is documented to do, not
# drift, so these stay scoped to FULL_LIVE the same way hooks/wrappers/MCP are above.
if [ "$FULL_LIVE" -eq 1 ]; then
  jq -e '.forceLoginMethod=="claudeai"' "$S" >/dev/null 2>&1 \
    && ok "forceLoginMethod configured" || bad "forceLoginMethod" "not set in $S"
  if [ -z "$AS" ] || printf '%s' "$AS" | jq -e '.loggedIn == false' >/dev/null 2>&1; then
    note "forceLoginMethod in effect" "unknown until you sign in"
  elif printf '%s' "$AS" | jq -e '.forcedLoginMethod=="claudeai"' >/dev/null 2>&1; then
    ok "forceLoginMethod in effect"
  else
    bad "forceLoginMethod in effect" "the CLI is not honouring it"
  fi
  [ -f "$HOME/.config/agents/shell/claude-parity.zsh" ] && ok "claude wrapper" || bad "claude wrapper" "missing"
  jq -e '.model=="claude-opus-5[1m]" and .effortLevel=="high" and .fastMode==true' "$S" >/dev/null 2>&1 \
    && ok "Conductor parity keys" || bad "Conductor parity keys" "drifted"
  jq -e '.skillListingMaxDescChars and .skillListingBudgetFraction and (.skillOverrides|length>0)' "$S" >/dev/null 2>&1 \
    && ok "context caps (skill listing)" || bad "context caps" "drifted"
elif [ -n "$PLUGIN_ROOT" ]; then
  note "forceLoginMethod / parity keys / context caps / claude wrapper" "not part of the plugin lane by design -- install.sh's settings merge is what writes these; take the full install"
else
  note "forceLoginMethod / parity keys / context caps / claude wrapper" "no install found, nothing to check"
fi
# A second global CLAUDE.md in $HOME shadows nothing but loads alongside ~/.claude/CLAUDE.md
# in every session — two always-on rule files drift into contradiction. One home: the vendored
# claude/CLAUDE.md in vstack. Independent of which lane is live: a stray ~/CLAUDE.md is wrong
# regardless of how vstack itself got installed.
[ ! -f "$HOME/CLAUDE.md" ] && ok "single global CLAUDE.md" || bad "stray ~/CLAUDE.md" "merge into vstack claude/CLAUDE.md, then delete"
section "project coverage"
# Every ACTIVE repo should carry the overlay lanes (.conductor run scripts + committed
# .claude) so Conductor previews and cloud sandboxes work there, not just locally. A repo
# with a commit in the last 45 days and no .conductor/settings.toml is an uncovered project.
dupescanned=0; stale=""; probe=""; hseen=""
# Second question, same enumeration: does the injector sitting in this directory know to stand
# down? Deduped on the hook file rather than on the repo, and asked twice per iteration — once at
# the directory itself and once at the main checkout it resolves to.
#
# Both calls earn their place. Coverage is a property of the committed tree, so judging it at the
# main checkout is right, and resolving there is also the only way this scan learns about repos
# outside the three glob roots. But double-firing is a property of the file on disk: a worktree
# parked on a branch without the guard carries its own copy and injects a second time while the
# main checkout it resolves to looks perfectly clean.
dupe_look(){
  h="$1/.claude/hooks/inject-session-context.sh"
  [ -f "$h" ] || return 0
  case " $hseen " in *" $h "*) return 0 ;; esac
  hseen="$hseen $h"
  dupescanned=$((dupescanned+1))
  if grep -q 'VSTACK_DUPE_SUPPRESS' "$h"; then
    [ -n "$probe" ] || probe="$h"
  else
    stale="$stale $(basename "$1")"
  fi
}
# `date -v-45d` is BSD/macOS; `date -d '45 days ago'` is GNU. BusyBox date (Alpine's only
# date) understands neither and this used to come back empty, silently skipping every repo.
# `date +%s` is the one flag all three agree on, so compute the cutoff as arithmetic on that
# instead of asking any date implementation to parse a relative-time string: BSD's `-r SECONDS`
# converts epoch seconds back to a date, and GNU/BusyBox's `-d @SECONDS` does the same — the two
# forms below are a strict superset of the BSD/GNU cases the old code handled, so nothing else
# needs to stay.
cutoff=""
now_epoch=$(date +%s 2>/dev/null)
if [ -n "$now_epoch" ]; then
  cutoff_epoch=$((now_epoch - 45*86400))
  cutoff=$(date -r "$cutoff_epoch" +%Y-%m-%d 2>/dev/null || date -d @"$cutoff_epoch" +%Y-%m-%d 2>/dev/null)
fi
if [ -z "$cutoff" ]; then
  # Every date form failing left cutoff empty, which skipped every repo, which left uncovered
  # empty, which printed a tick. Total failure of the check reported as a pass.
  bad "active repos overlaid" "could not compute a cutoff date — nothing was scanned"
else
  uncovered=""; scanned=0
  # Two fixes here. `.git` is a file rather than a directory inside a git worktree, so the old
  # -d test made every Conductor workspace invisible to a check whose entire job is finding
  # uncovered working repos. And Conductor nests them as workspaces/<project>/<workspace>, so
  # a single level of globbing only ever saw the container directories.
  seen=""
  for r in "$HOME/Projects"/*/ "$HOME/conductor/repos"/*/ "$HOME/conductor/workspaces"/*/*/; do
    [ -e "$r/.git" ] || continue
    dupe_look "${r%/}"
    # Resolve a worktree to the checkout it belongs to, and judge coverage there. Two reasons:
    # the overlay is committed, so fixing the main checkout fixes every workspace of that
    # project; and Conductor's workspaces are the only way this scan ever learns about repos
    # living outside the directories below — every one of these projects actually lives under
    # ~/Desktop, which no hardcoded root list here was ever going to guess.
    main=$(cd "$r" 2>/dev/null && cd "$(git rev-parse --git-common-dir 2>/dev/null)/.." 2>/dev/null && pwd) || continue
    [ -n "$main" ] || continue
    dupe_look "$main"
    case " $seen " in *" $main "*) continue ;; esac
    seen="$seen $main"
    last=$(git -C "$main" log -1 --format=%cs 2>/dev/null) || continue
    [ -n "$last" ] && [ "$last" \> "$cutoff" ] || continue
    scanned=$((scanned+1))
    [ -f "$main/.conductor/settings.toml" ] || uncovered="$uncovered $(basename "$main")"
  done
  uncovered=$(printf '%s' "$uncovered" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')
  # Scanning zero repos is not a pass. On any machine that does not use this layout the loop
  # matched nothing, uncovered stayed empty, and the tick appeared over a check that compared
  # nothing at all -- the same shape as every other green this project has had to go back and
  # fix. Say what was looked at instead.
  if [ "$scanned" = 0 ]; then
    note "active repos overlaid" "no git repos found under ~/Projects, ~/conductor/repos or ~/conductor/workspaces — nothing scanned"
  elif [ -z "$uncovered" ]; then
    ok "active repos overlaid ($scanned scanned)"
  else
    bad "active repos overlaid" "missing overlay: ${uncovered}(run 'vstack overlay <repo>')"
  fi
fi
section "hook scope overlap"
# Claude Code MERGES hook arrays across settings layers instead of overriding them, so a repo
# carrying the committed overlay ran ~/.claude's injector AND its own: baseline block, digest and
# directives, twice per turn. The project copy stands down now — but a repo's copy is only as
# current as its last `vstack overlay`, so the guard has to be confirmed per repo.
stale=$(printf '%s' "$stale" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')
if [ "$dupescanned" = 0 ]; then
  note "project hook stands down" "no active repo carries a committed .claude injector — nothing scanned"
elif [ -n "$stale" ]; then
  bad "project hook stands down" "stale overlay, still double-fires: ${stale}(run 'vstack overlay <repo>')"
else
  # Grepping for the guard proves it is present, not that it fires. Run both copies for real and
  # read what they actually emit. Testing only the silent side would rate a wholly broken script
  # as healthy, so the user-scope copy has to be shown still speaking.
  ev='{"hook_event_name":"UserPromptSubmit","session_id":"doctor","prompt":"x"}'
  pout=$(printf '%s' "$ev" | "$probe" 2>/dev/null)
  gout=$(printf '%s' "$ev" | "$HOME/.claude/hooks/inject-session-context.sh" 2>/dev/null)
  perr=""
  case "$pout" in
    *additionalContext*) perr="project copy $probe still injects" ;;
    *hookEventName*) ;;
    *) perr="project copy emitted no valid hook JSON: ${pout:-<empty>}" ;;
  esac
  case "$gout" in
    *additionalContext*) ;;
    *) perr="${perr:+$perr; }user-scope copy went silent too — suppression is over-firing" ;;
  esac
  [ -z "$perr" ] && ok "project hook stands down ($dupescanned repos, both scopes probed)" \
                 || bad "project hook stands down" "$perr"
fi
section "release reachability"
# The gate can prove the declared version is tagged here. It cannot prove a stranger can fetch it,
# because that means a network call and .claude/verify.sh has to stay offline and hermetic. So the
# question lands here instead, where doctor already talks to the network.
#
# It is not academic. Every tag from v1.13.2 on lived only on this machine while README.md handed
# strangers a URL built from it, so check 24 was green and the documented install path was a 404
# at the same moment, for four releases. Two true statements about different things, and nothing
# compared them.
#
# Unreachable network is a note, never a pass and never a failure -- being on a plane is not drift,
# but neither is it evidence that the release is fetchable.
_rr=$(resolve_vstack_repo 2>/dev/null) || _rr=""
if [ -z "$_rr" ] || ! command -v git >/dev/null 2>&1; then
  note "declared release is fetchable" "no vstack repo or git found, so nothing was checked"
else
  _rv=$(jq -r '.version // empty' "$_rr/claude/.claude-plugin/plugin.json" 2>/dev/null)
  _ru=$(git -C "$_rr" remote get-url origin 2>/dev/null)
  if [ -z "$_rv" ]; then
    bad "declared release is fetchable" "could not read a version from claude/.claude-plugin/plugin.json"
  elif [ -z "$_ru" ]; then
    note "declared release is fetchable" "no origin remote, so v$_rv is local by design"
  else
    # Distinguishing "the remote says no" from "the remote did not answer" is the whole point: one
    # is a broken install path, the other is a laptop offline, and reporting either as the other is
    # how a check starts lying.
    _out=$(GIT_TERMINAL_PROMPT=0 run_with_timeout 5 git -C "$_rr" ls-remote --tags origin "refs/tags/v$_rv" 2>&1); _rc=$?
    if [ "$_rc" -ne 0 ]; then
      _reason="could not reach origin"
      if [ "$_rc" -eq 124 ] || [ "$_rc" -eq 143 ]; then _reason="origin did not answer within 5s"; fi
      note "declared release is fetchable" "$_reason, so v$_rv is unverified: $(printf '%s' "$_out" | head -1)"
    elif [ -n "$_out" ]; then
      ok "declared release is fetchable (v$_rv on origin)"
    else
      bad "declared release is fetchable" "v$_rv is declared and pinned in the README but is not on origin — the documented install URL 404s (git -C $_rr push --follow-tags)"
    fi
  fi
fi
section "context"
# With autoCompactWindow unset, Claude Code compacts at the model's context limit -- ~967K of
# Opus 5's 1M -- so a session takes one late squeeze instead of several small ones, and compaction
# loss scales with both the compression ratio and the cycle count (arXiv 2606.22528). Measured on
# v2.1.241 with the window pinned to 100K: compaction fires between 68K and 81K, i.e. at 68 to 81
# percent of the window rather than at it, and each event costs 33 to 81 seconds of wall time. So
# 300K here means a real trigger near 230K. A window set too low thrashes: 100K produced three
# compactions in an eight turn session.
# Asserted against the LIVE file, not the repo's: a value this repo ships and the merge failed to
# apply is the failure that matters, and it is invisible from the repo side. The "shipped"
# branch is a repo-integrity assertion and fires regardless of lane; the live-value comparison
# below it only means anything once install.sh has actually merged into $CDIR/settings.json,
# which the plugin lane never does -- so that half is scoped to FULL_LIVE.
_acw_want=$(jq -r '.autoCompactWindow // empty' "${R:-/nonexistent}/claude/settings.json" 2>/dev/null)
_acw_have=$(jq -r '.autoCompactWindow // empty' "$S" 2>/dev/null)
if [ -z "$_acw_want" ] && [ -n "$R" ]; then
  bad "autoCompactWindow shipped" "claude/settings.json no longer sets it -- the pin was dropped from the repo, not merely from the install"
elif [ "$FULL_LIVE" -eq 1 ]; then
  if [ -n "$_acw_have" ] && { [ -z "$R" ] || [ "$_acw_have" = "$_acw_want" ]; }; then
    ok "autoCompactWindow (${_acw_have})"
  else
    bad "autoCompactWindow" "live settings has '${_acw_have:-unset}', repo ships '${_acw_want:-?}' -- unset means compaction waits for the model's context limit (./install.sh)"
  fi
elif [ -n "$PLUGIN_ROOT" ]; then
  note "autoCompactWindow" "not merged by the plugin lane by design -- take the full install"
else
  note "autoCompactWindow" "no install found, nothing to check"
fi

# The statusline duplicates that threshold so it can render without a second jq spawn per turn.
# A statusline that turns red at a number the runtime does not compact at is the same defect this
# repo spent a day removing: a green that measures nothing. Assert the copy against the source.
# Only meaningful once install.sh has put a statusline at $CDIR/statusline.sh -- the plugin
# lane leaves its own copy inert inside the cache directory, never wired via settings.json.
if [ "$FULL_LIVE" -eq 1 ]; then
  _sl="$CDIR/statusline.sh"
  _slw=$(sed -n 's/^CTX_COMPACT_WINDOW=\([0-9]*\).*/\1/p' "$_sl" 2>/dev/null | head -1)
  if [ -z "$_slw" ]; then
    bad "statusline shows context" "$_sl sets no CTX_COMPACT_WINDOW -- context occupancy is not rendered, so the window cannot be tuned by observation"
  elif [ -n "$_acw_have" ] && [ "$_slw" != "$_acw_have" ]; then
    bad "statusline threshold" "statusline warns at $_slw but Claude Code compacts at $_acw_have"
  else
    ok "statusline context threshold ($_slw)"
  fi
elif [ -n "$PLUGIN_ROOT" ]; then
  note "statusline shows context" "not wired by the plugin lane by design -- take the full install"
else
  note "statusline shows context" "no install found, nothing to check"
fi

# Compaction replaces the conversation layer, and the session baseline is injected into it at
# SessionStart. Without compact instructions the routing table does not survive the first
# compaction -- silently, which is the whole problem. $CDIR/CLAUDE.md is install.sh's merged
# copy; the plugin lane never writes one there.
if [ "$FULL_LIVE" -eq 1 ]; then
  if grep -q '^# Compact instructions' "$CDIR/CLAUDE.md" 2>/dev/null; then
    ok "compact instructions in CLAUDE.md"
  else
    bad "compact instructions" "$CDIR/CLAUDE.md has no '# Compact instructions' section -- the routing table will not survive a compaction"
  fi
elif [ -n "$PLUGIN_ROOT" ]; then
  note "compact instructions" "not merged by the plugin lane by design -- take the full install"
else
  note "compact instructions" "no install found, nothing to check"
fi
section "remote/dispatch"
[ -n "${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-}" ] && bad "nonessential-traffic" "set — DISABLES Remote Control feature flags" || ok "feature-flag eval enabled"
# remoteControlAtStartup is another install.sh settings-merge key; the plugin lane never sets it.
if [ "$FULL_LIVE" -eq 1 ]; then
  jq -e '.remoteControlAtStartup==true' "$S" >/dev/null 2>&1 && ok "remoteControlAtStartup" || bad "remoteControlAtStartup" "off"
elif [ -n "$PLUGIN_ROOT" ]; then
  note "remoteControlAtStartup" "not merged by the plugin lane by design -- take the full install"
else
  note "remoteControlAtStartup" "no install found, nothing to check"
fi
B="$HOME/Library/Application Support/Claude/bridge-state.json"
if [ -f "$B" ]; then
  want=$(jq -r '.remote.defaultEnvironmentId // ""' "$S")
  jq -e --arg w "$want" 'to_entries | map(.value.environmentId) | index($w)' "$B" >/dev/null 2>&1 \
    && ok "bridge env matches settings" || bad "bridge env" "settings=$want not in bridge-state.json"
fi
[ "${1:-}" = "--mcp" ] && { echo "── mcp ──"; claude mcp list 2>/dev/null | grep -E 'Connected|Failed'; }
section "CI"
# GitHub Actions CI health is unverifiable locally — what runs green here may fail in the sandbox.
# This check reaches GitHub to read the conclusion of the last run on main. If CI is failing, any
# release built from that commit is unreliable, and any install from that release inherits the
# unseen breakage. `gh run list` reports both the conclusion (success/failure/cancelled/timed_out)
# and the status (completed/in_progress/requested/queued/stale); this check handles both.
#
# Skip honestly: each missing dependency (gh, jq, auth, network, GitHub remote) names itself.
# A skip is reported as a note, not a pass: the output line appears with the dot notation used
# elsewhere for informational lines and does not contribute to the final verdict.
_ci_skip=""
if ! command -v gh >/dev/null 2>&1; then
  _ci_skip="gh not on PATH"
elif ! command -v jq >/dev/null 2>&1; then
  _ci_skip="jq not on PATH"
elif ! gh auth status >/dev/null 2>&1; then
  _ci_skip="not authenticated with GitHub"
else
  _rr=$(resolve_vstack_repo 2>/dev/null) || _rr=""
  if [ -z "$_rr" ]; then
    _ci_skip="vstack repo not found"
  fi

  if [ -z "$_ci_skip" ]; then
    if ! _remote=$(git -C "$_rr" remote get-url origin 2>/dev/null) || [ -z "$_remote" ]; then
      _ci_skip="no GitHub remote"
    fi
  fi

  if [ -z "$_ci_skip" ]; then
    # Timeout chosen at 5s: slow enough for most networks, fast enough that a dead network
    # (blackholed DNS, wrong gateway) does not stall doctor for the underlying transport's 75s+
    # connect timeout. This is the same rationale as the release-reachability check's timeout.
    _ci_out=$(run_with_timeout 5 gh run list --branch main --limit 1 --json conclusion,status,displayTitle,databaseId 2>&1)
    _rc=$?
    if [ "$_rc" -eq 124 ] || [ "$_rc" -eq 143 ]; then
      _ci_skip="gh timed out after 5s"
    elif [ "$_rc" -ne 0 ]; then
      _ci_skip="gh query failed"
    elif [ -z "$_ci_out" ]; then
      _ci_skip="no runs found for main"
    else
      _conclusion=$(printf '%s' "$_ci_out" | jq -r '.[0].conclusion // "null"' 2>/dev/null)
      _status=$(printf '%s' "$_ci_out" | jq -r '.[0].status // "null"' 2>/dev/null)
      _title=$(printf '%s' "$_ci_out" | jq -r '.[0].displayTitle // "?"' 2>/dev/null)
      _id=$(printf '%s' "$_ci_out" | jq -r '.[0].databaseId // "?"' 2>/dev/null)

      if [ "$_status" = "null" ] || [ "$_title" = "?" ]; then
        bad "CI" "could not parse run from gh output"
      elif [ "$_status" != "completed" ]; then
        note "CI" "run in progress: $_title"
      elif [ "$_conclusion" = "success" ]; then
        ok "CI (main: $_title)"
      elif [ "$_conclusion" = "failure" ] || [ "$_conclusion" = "cancelled" ] || [ "$_conclusion" = "timed_out" ]; then
        bad "CI" "$_conclusion on main: $_title (run $_id) — gh run view $_id --log-failed"
      else
        bad "CI" "unexpected conclusion '$_conclusion' on main: $_title"
      fi
    fi
  fi
fi

if [ -n "$_ci_skip" ]; then
  note "CI" "skipped — $_ci_skip"
fi

if [ "$JSON_MODE" = 1 ]; then
  # Restore the real stdout the block above was borrowing fd 4 to avoid; everything from here
  # down is the ONLY thing that reaches it, so `doctor --json | jq -e .` sees one JSON value.
  exec 1>&4 4>&-

  INSTALL_LANE="none"
  [ "$FULL_LIVE" -eq 1 ] && INSTALL_LANE="full"
  [ "$FULL_LIVE" -ne 1 ] && [ -n "$PLUGIN_ROOT" ] && INSTALL_LANE="plugin"

  # Precedence: an actual failure found by the audit (FAIL) or actual drift (DRIFT_STATUS=drift)
  # always outranks a measurement gap -- if something is provably broken, that IS the answer,
  # "could not fully measure" is not a downgrade of it. A measurement gap only gets its own exit
  # code (3) when it is the *only* thing wrong, so it can never be silently folded into either
  # "healthy" (0, wrong -- it wasn't measured) or a generic "unhealthy" (1, wrong -- nothing was
  # actually found broken, something just couldn't be checked).
  EXIT_CODE=0
  if [ "$FAIL" -ne 0 ] || [ "$DRIFT_STATUS" = "drift" ]; then
    EXIT_CODE=1
  elif [ "$DRIFT_STATUS" = "error" ]; then
    EXIT_CODE=3
  fi

  CHECKS_JSON=$(printf '%s' "$JSON_ROWS" | jq -s '[.[] | select(.status=="ok" or .status=="bad") | {category,label,status,detail}]')
  SKIPS_JSON=$(printf '%s' "$JSON_ROWS" | jq -s '[.[] | select(.status=="note") | {category,label,detail}]')

  jq -n \
    --arg version "$VSTACK_VERSION" \
    --arg installLane "$INSTALL_LANE" \
    --arg driftStatus "$DRIFT_STATUS" \
    --argjson driftCompared "$DRIFT_COMPARED" \
    --arg driftDetail "$DRIFT_DETAIL" \
    --arg trustState "$TRUST_STATE" \
    --arg trustDetail "$TRUST_DETAIL" \
    --argjson depJq "$DEP_JQ" --argjson depGit "$DEP_GIT" --argjson depGh "$DEP_GH" \
    --argjson depClaude "$DEP_CLAUDE" --argjson depTimeout "$DEP_TIMEOUT" \
    --argjson lvAvailable "$LV_AVAILABLE" --arg lvTimestamp "$LV_TS" --arg lvSource "$LV_SRC" \
    --argjson checks "$CHECKS_JSON" --argjson skips "$SKIPS_JSON" \
    --argjson failCount "$FAIL" --argjson exitCode "$EXIT_CODE" \
    '{
      schemaVersion: 1,
      version: ($version | if . == "" then null else . end),
      installLane: $installLane,
      profile: null,
      drift: { status: $driftStatus, itemsCompared: $driftCompared, detail: $driftDetail },
      trust: { state: $trustState, detail: $trustDetail },
      dependencies: { jq: $depJq, git: $depGit, gh: $depGh, claude: $depClaude, timeout: $depTimeout },
      lastVerification: {
        available: $lvAvailable,
        timestamp: ($lvTimestamp | if . == "" then null else . end),
        source: ($lvSource | if . == "" then null else . end)
      },
      checks: $checks,
      skips: $skips,
      failCount: $failCount,
      healthy: ($exitCode == 0),
      exitCode: $exitCode
    }'
  exit "$EXIT_CODE"
fi

echo
if [ "$FAIL" -eq 0 ]; then
  echo "ALL GREEN ✔   (· lines are yours to decide on, not drift)"
else
  echo "DRIFT ✖"
fi
exit $FAIL
