#!/usr/bin/env bash
# vstack — one-word dispatcher for the common vstack operations.
#
# Usage: vstack <update|install|doctor|overlay|verify|uninstall|help> [args...]
set -uo pipefail
SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<'EOF'
usage: vstack <command> [args...]

commands:
  update [--yes]      fetch, show the full diff of everything about to be merged, confirm, install
  install [args...]   run the repo's install.sh (args passed through, e.g. --dry-run)
  doctor [args...]    run ~/.config/agents/bin/doctor (args passed through, e.g. --drift)
  overlay <repo>       run the repo's overlay.sh against <repo>
  verify               run the repo's .claude/verify.sh
  test                 run tests/auto-trigger.sh (live skill-firing regression; needs claude auth, ~15 min)
  trust [repo-dir] [--yes]
                        trust a repo's .claude/verify.sh so the Stop-hook gate runs it unattended;
                        refuses without a terminal to confirm on unless --yes is given
  uninstall [args...]  run the repo's uninstall.sh (args passed through)
  self-test             offline, zero-model checks against THIS machine's installed state
                         (not the repo checkout -- see 'verify' for that). Single verdict,
                         declared/ran/skipped accounting; a run that ran nothing cannot pass.
  help                 show this message

The repo is resolved the same way as `doctor --drift`: $VSTACK_DIR, else ~/.vstack, else the
git root containing this script's parent (if it has claude/settings.json).
EOF
}

resolve_vstack_repo() {
  if [ -n "${VSTACK_DIR:-}" ] && [ -f "$VSTACK_DIR/claude/settings.json" ]; then
    printf '%s\n' "$VSTACK_DIR"; return 0
  fi
  # install.sh records where it last ran from, so a repo cloned anywhere is findable.
  if [ -f "$HOME/.config/agents/vstack-repo" ]; then
    p=$(cat "$HOME/.config/agents/vstack-repo")
    [ -f "$p/claude/settings.json" ] && { printf '%s\n' "$p"; return 0; }
  fi
  if [ -f "$HOME/.vstack/claude/settings.json" ]; then
    printf '%s\n' "$HOME/.vstack"; return 0
  fi
  sdir=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || sdir=""
  root=""
  [ -n "$sdir" ] && root=$(cd "$sdir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
  if [ -n "${root:-}" ] && [ -f "$root/claude/settings.json" ]; then
    printf '%s\n' "$root"; return 0
  fi
  return 1
}

# --- local run log -------------------------------------------------------------------------
# NOT an attestation and NOT a receipt. It is unsigned plaintext, appended to by whatever ran
# as this user, and readable and editable by anything else running as this user -- it proves
# nothing to anyone it did not come from. It exists so a later command on THIS machine can see
# what a run measured, not to vouch for that run to anyone else. See
# docs/checks-that-inherit-their-answer.md for why a record that can silently claim more than
# it measured is worse than no record: every field below either carries a real value or the
# literal string "UNKNOWN" -- never a fabricated 0, false, or empty string standing in for "I
# don't know." Local only. No network call is made to produce or ship this file.
RUNLOG="$HOME/.config/agents/vstack-runlog.jsonl"
runlog_write() { # <command> <outcome:VERIFIED|FAILED> <declared> <ran> <skipped> <exitCode>
  _rl_cmd="$1"; _rl_outcome="$2"; _rl_decl="${3:-}"; _rl_ran="${4:-}"; _rl_skip="${5:-}"; _rl_rc="${6:-}"
  if ! command -v jq >/dev/null 2>&1; then
    echo "run log: not written -- jq not installed (would have recorded: $_rl_cmd $_rl_outcome)" >&2
    return 0
  fi
  mkdir -p "$(dirname "$RUNLOG")" 2>/dev/null || {
    echo "run log: not written -- cannot create $(dirname "$RUNLOG")" >&2; return 0; }
  # The SHA and dirty flag are read from $REPO, which self-test/explain resolve on a
  # best-effort basis and may leave empty (plugin-only lane, or no repo findable at all). An
  # absent or unresolvable repo must serialise as UNKNOWN, not as the SHA of whatever repo
  # happened to be lying around, and not as "clean" by default.
  _rl_sha="UNKNOWN"; _rl_dirty="UNKNOWN"
  if [ -n "${REPO:-}" ] && command -v git >/dev/null 2>&1 && git -C "$REPO" rev-parse HEAD >/dev/null 2>&1; then
    _rl_sha=$(git -C "$REPO" rev-parse HEAD 2>/dev/null)
    if git -C "$REPO" diff --quiet 2>/dev/null && git -C "$REPO" diff --cached --quiet 2>/dev/null; then
      _rl_dirty=false
    else
      _rl_dirty=true
    fi
  fi
  _rl_ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo UNKNOWN)
  jq -nc \
    --arg kind "local-run-log-entry" \
    --arg schemaNote "unsigned plaintext, local only -- not an attestation, not a receipt, editable by anything running as this user" \
    --arg command "$_rl_cmd" \
    --arg outcome "$_rl_outcome" \
    --arg timestamp "$_rl_ts" \
    --arg sha "$_rl_sha" \
    --arg dirty "$_rl_dirty" \
    --arg declared "$_rl_decl" --arg ran "$_rl_ran" --arg skipped "$_rl_skip" \
    --arg exitCode "$_rl_rc" \
    '{
      kind: $kind, schemaNote: $schemaNote, command: $command, outcome: $outcome,
      timestamp: (if $timestamp == "" then "UNKNOWN" else $timestamp end),
      sha: (if $sha == "" then "UNKNOWN" else $sha end),
      repoDirty: (if $dirty == "true" then true elif $dirty == "false" then false else "UNKNOWN" end),
      declared: (if ($declared|test("^[0-9]+$")) then ($declared|tonumber) else "UNKNOWN" end),
      ran:      (if ($ran|test("^[0-9]+$"))      then ($ran|tonumber)      else "UNKNOWN" end),
      skipped:  (if ($skipped|test("^[0-9]+$"))  then ($skipped|tonumber)  else "UNKNOWN" end),
      exitCode: (if ($exitCode|test("^[0-9]+$"))  then ($exitCode|tonumber) else "UNKNOWN" end)
    }' >> "$RUNLOG" 2>/dev/null
}

# --- self-test -------------------------------------------------------------------------------
# The offline, zero-model checks that answer "is THIS machine's install working?" -- as
# opposed to .claude/verify.sh (proves a repo CHECKOUT is installable/portable) and
# tests/install-matrix.sh / tests/bin-scripts.sh (dev tests that install into throwaway HOMEs
# or lint the checkout's own copies). Before this, a user with a broken install had to already
# know which of those four to reach for.
#
# Same bar as verify.sh's footer, deliberately: a check that could not run SKIPs and names the
# missing dependency, ran+skipped must equal declared, and a run that ran nothing must not
# report success -- that last one is not implied by the accounting line, so it is asserted
# separately. TOTAL is counted from this function's own `# --- self-test N.` markers so a check
# added later cannot silently drop out of the count the way check 18 in docs/checks-that-
# inherit-their-answer.md dropped out of a hand-maintained one.
cmd_self_test() {
  ST_CDIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  ST_FAIL=0; ST_RAN=0; ST_SKIPPED=0
  ST_TOTAL=$(grep -c '^  # --- self-test [0-9]' "$SELF")
  st_ok(){   printf 'ok    %s\n' "$1"; ST_RAN=$((ST_RAN+1)); }
  st_bad(){  printf 'FAIL  %s\n%s\n' "$1" "${2:-}"; ST_FAIL=1; ST_RAN=$((ST_RAN+1)); }
  st_skip(){ printf 'skip  %s (%s)\n' "$1" "$2"; ST_SKIPPED=$((ST_SKIPPED+1)); }

  echo "vstack self-test: offline, zero-model checks against this machine's installed state"
  echo "(not the repo checkout -- 'vstack verify' proves that)"
  echo

  ST_DOC="$HOME/.config/agents/bin/doctor"
  [ -x "$ST_DOC" ] || ST_DOC="${REPO:-}/bin/doctor"

  # --- self-test 1. doctor audit (installed state) -------------------------------------------
  if [ -x "$ST_DOC" ]; then
    st_doc_out=$("$ST_DOC" 2>&1); st_doc_rc=$?
    if [ "$st_doc_rc" -eq 0 ]; then
      st_ok "doctor audit (installed state)"
    else
      st_bad "doctor audit (installed state)" "$(printf '%s\n' "$st_doc_out" | grep '✖' | head -10)"
    fi
  else
    st_skip "doctor audit (installed state)" "no doctor executable at \$HOME/.config/agents/bin/doctor or \$REPO/bin/doctor"
  fi

  # --- self-test 2. doctor --drift (installed state vs the source repo) ----------------------
  if [ -x "$ST_DOC" ]; then
    st_drift_out=$("$ST_DOC" --drift 2>&1); st_drift_rc=$?
    if printf '%s\n' "$st_drift_out" | grep -q 'no vstack repo found'; then
      st_skip "doctor --drift (installed vs source repo)" "no vstack repo resolvable from this machine"
    elif [ "$st_drift_rc" -eq 0 ]; then
      st_ok "doctor --drift (installed vs source repo)"
    else
      st_bad "doctor --drift (installed vs source repo)" "$(printf '%s\n' "$st_drift_out" | grep -E 'missing|differs|error' | head -10)"
    fi
  else
    st_skip "doctor --drift (installed vs source repo)" "no doctor executable found"
  fi

  # --- self-test 3. installed hook scripts parse as valid bash --------------------------------
  # doctor --drift (above) proves a full-lane install matches the repo byte for byte when a
  # repo is resolvable. This is what still catches a corrupted deploy (a truncated copy, a
  # partial write) on a machine where no repo is around to diff against at all.
  if [ -d "$ST_CDIR/hooks" ] && [ -n "$(ls -A "$ST_CDIR/hooks" 2>/dev/null)" ]; then
    st_errs=""
    for st_f in "$ST_CDIR"/hooks/*.sh; do
      [ -e "$st_f" ] || continue
      st_out=$(bash -n "$st_f" 2>&1) || st_errs="$st_errs
$(basename "$st_f"): $st_out"
    done
    if [ -z "$st_errs" ]; then st_ok "installed hook scripts parse ($ST_CDIR/hooks)"
    else st_bad "installed hook scripts parse" "$st_errs"; fi
  else
    st_skip "installed hook scripts parse" "$ST_CDIR/hooks missing or empty -- plugin lane, or no full install here"
  fi

  # --- self-test 4. installed bin scripts parse as valid bash ---------------------------------
  ST_BINDIR="$HOME/.config/agents/bin"
  if [ -d "$ST_BINDIR" ] && [ -n "$(ls -A "$ST_BINDIR" 2>/dev/null)" ]; then
    st_errs=""
    for st_f in "$ST_BINDIR"/*; do
      [ -f "$st_f" ] || continue
      head -c 64 "$st_f" 2>/dev/null | grep -q '^#!.*sh' || continue
      st_out=$(bash -n "$st_f" 2>&1) || st_errs="$st_errs
$(basename "$st_f"): $st_out"
    done
    if [ -z "$st_errs" ]; then st_ok "installed bin scripts parse ($ST_BINDIR)"
    else st_bad "installed bin scripts parse" "$st_errs"; fi
  else
    st_skip "installed bin scripts parse" "$ST_BINDIR missing or empty"
  fi

  # --- self-test 5. installed settings.json is valid JSON -------------------------------------
  if ! command -v jq >/dev/null 2>&1; then
    st_skip "settings.json valid JSON" "jq not installed"
  elif [ ! -f "$ST_CDIR/settings.json" ]; then
    st_skip "settings.json valid JSON" "$ST_CDIR/settings.json does not exist"
  elif jq -e . "$ST_CDIR/settings.json" >/dev/null 2>&1; then
    st_ok "settings.json valid JSON ($ST_CDIR/settings.json)"
  else
    st_bad "settings.json valid JSON" "$ST_CDIR/settings.json does not parse"
  fi

  echo
  printf 'self-test: %d declared, %d ran, %d skipped\n' "$ST_TOTAL" "$ST_RAN" "$ST_SKIPPED"
  if [ "$((ST_RAN + ST_SKIPPED))" -ne "$ST_TOTAL" ]; then
    echo "FAIL  self-test accounting"
    echo "      $((ST_TOTAL - ST_RAN - ST_SKIPPED)) declared check(s) reported nothing"
    ST_FAIL=1
  fi
  # The bar this file's checks are held to, held right back: a run that ran nothing is not a
  # pass just because nothing it ran came back FAIL. All five checks skip in the same run only
  # when doctor is entirely absent, which cannot happen on a real vstack install (doctor ships
  # in bin/*, installed to $HOME/.config/agents/bin) -- so ST_RAN==0 here means something is
  # badly wrong (no doctor, no hooks dir, no bin dir, no settings.json, no jq), not that the
  # machine is healthy.
  if [ "$ST_RAN" -eq 0 ]; then
    echo "FAIL  self-test ran nothing -- a self-test that ran nothing must not report success"
    ST_FAIL=1
  fi

  if [ "$ST_FAIL" -eq 0 ]; then ST_OUTCOME=VERIFIED; else ST_OUTCOME=FAILED; fi
  runlog_write "self-test" "$ST_OUTCOME" "$ST_TOTAL" "$ST_RAN" "$ST_SKIPPED" "$ST_FAIL"

  [ "$ST_FAIL" -eq 0 ] && echo "SELF-TEST OK" || echo "SELF-TEST FAILED"
  return "$ST_FAIL"
}

CMD="${1:-}"
[ $# -gt 0 ] && shift

case "$CMD" in
  ""|help|-h|--help)
    usage
    exit 0
    ;;
esac

# self-test exists specifically to work on a machine where no repo checkout is around at all
# -- a plugin-only install, or a full install whose original clone was deleted after
# ./install.sh ran. Every other command still needs $REPO to find the script it runs
# (install.sh, overlay.sh, uninstall.sh, .claude/verify.sh), so this stays a hard failure for
# them; self-test says UNKNOWN for whatever specifically needed a repo (see checks 1/2).
REPO=$(resolve_vstack_repo) || REPO=""
if [ -z "$REPO" ]; then
  case "$CMD" in
    self-test) : ;;
    *)
      echo "vstack: no vstack repo found (checked \$VSTACK_DIR, ~/.vstack, and this script's git root)" >&2
      echo "vstack: set \$VSTACK_DIR to your checkout, or clone one to ~/.vstack" >&2
      exit 1
      ;;
  esac
fi

case "$CMD" in
  update)
    # This used to be `git pull && install.sh`, which re-recorded the trust hashes for
    # whatever arrived — the one unattended path where new code got trusted sight unseen.
    # Now: fetch, show the incoming commits and the full diff of every script the gate
    # executes, and ask. Without a terminal, refuse rather than assume; --yes is the
    # explicit escape hatch for automation.
    YES=0
    for a in "$@"; do case "$a" in --yes|-y) YES=1 ;; esac; done
    # Bare fetch with fetch.prune=true deletes local tags not on the remote. See bin/doctor:260
    # and the 2026-08-20 incident where unpushed release tags were silently destroyed.
    git -C "$REPO" fetch -q --no-tags --no-prune --no-write-fetch-head origin || exit 1
    upstream=$(git -C "$REPO" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || upstream=""
    if [ -z "$upstream" ] || ! git -C "$REPO" rev-parse --verify -q "$upstream" >/dev/null 2>&1; then
      # No configured upstream, or it points at a ref that does not exist locally. This is the
      # shape the README's own pin quickstart leaves behind: `VSTACK_REF=vX.Y.Z bash
      # bootstrap.sh` clones with `--depth 1 --branch vX.Y.Z`, which sets remote.origin.fetch to
      # fetch *only that tag* -- refs/remotes/origin/main never gets created. The old code
      # silently fell back to the literal string "origin/main", which then failed to resolve;
      # git wrote that to stderr (discarded), rev-list produced empty stdout, and the empty
      # check below read that identically to "nothing to update". A pinned install could never
      # discover it was behind.
      #
      # Repair rather than refuse: widen the fetch refspec to track main and drop the shallow
      # boundary. Unshallowing matters as much as the refspec does -- a shallow fetch of just
      # main's tip would let the rev-list check below detect drift, but `git merge --ff-only`
      # further down needs real ancestry to prove main is a fast-forward of HEAD, which two
      # disconnected shallow histories cannot supply.
      upstream=origin/main
      repair_err=$(git -C "$REPO" config remote.origin.fetch "+refs/heads/main:refs/remotes/origin/main" 2>&1)
      if [ -z "$repair_err" ]; then
        if [ "$(git -C "$REPO" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then
          repair_err=$(git -C "$REPO" fetch -q --no-tags --no-prune --no-write-fetch-head --unshallow origin 2>&1)
        else
          repair_err=$(git -C "$REPO" fetch -q --no-tags --no-prune --no-write-fetch-head origin 2>&1)
        fi
      fi
      if ! git -C "$REPO" rev-parse --verify -q "$upstream" >/dev/null 2>&1; then
        echo "vstack update: could not resolve $upstream even after repairing the fetch refspec" >&2
        [ -n "$repair_err" ] && echo "               git said: $repair_err" >&2
        echo "               this checkout may not be a clone of the vstack repo, or main was renamed;" >&2
        echo "               re-clone with 'git clone $(git -C "$REPO" remote get-url origin 2>/dev/null || echo "$REPO")' to recover" >&2
        exit 1
      fi
    fi
    revlist_out=$(git -C "$REPO" rev-list -n 1 "HEAD..$upstream" 2>&1)
    revlist_rc=$?
    if [ "$revlist_rc" -ne 0 ]; then
      # Never let a failed comparison read as "nothing to update" -- that is the exact defect
      # class this block exists to close. An unresolved or unwalkable ref must be loud.
      echo "vstack update: could not compare HEAD to $upstream: $revlist_out" >&2
      exit 1
    fi
    if [ -z "$revlist_out" ]; then
      echo "vstack update: already up to date with $upstream; reinstalling to clear drift"
      exec "$REPO/install.sh"
    fi
    echo "incoming from $upstream:"
    git -C "$REPO" log --oneline "HEAD..$upstream"
    # install.sh deploys nearly this whole repo -- claude/hooks/*.sh, claude/agents, commands,
    # skills, bin/*, settings.json, CLAUDE.md -- so a diff scoped to "the scripts the gate
    # executes" was a narrower promise than this command actually carries out. It could (and
    # did, in the v1.28.0 audit) print "no changes to the scripts the gate executes" while
    # about to install a rewritten claude/hooks/guard-destructive.sh, because that file was
    # never in the reviewed set.
    #
    # Fixed by reviewing everything that is about to be merged, not a hand-maintained subset of
    # it. A list of "trusted" paths would need a new entry every time install.sh grows another
    # `cp` target, and forgetting one silently reopens this exact hole -- a full diff cannot
    # drift out of sync with what gets installed, because it does not try to describe that
    # surface at all. The gate-executing scripts are still called out separately below, with a
    # warning, because those are the ones an attacker would target first: change one of them
    # and the next `vstack trust` or `install.sh` run re-signs the tampered version.
    GATE_SCRIPTS="install.sh overlay.sh uninstall.sh bootstrap.sh .claude/verify.sh"
    gate_changed=""
    for g in $GATE_SCRIPTS; do
      git -C "$REPO" diff --quiet "HEAD..$upstream" -- "$g" 2>/dev/null || gate_changed="$gate_changed $g"
    done
    if [ -n "$gate_changed" ]; then
      echo
      echo "WARNING: this changes scripts the gate itself executes, and will re-trust them on merge:$gate_changed"
    fi
    changed=$(git -C "$REPO" diff --name-only "HEAD..$upstream")
    nfiles=$(printf '%s\n' "$changed" | grep -c .)
    echo
    echo "full diff, $upstream vs HEAD ($nfiles file(s) changed -- install.sh deploys nearly all of this repo, so this is everything that is about to land, not a reviewed subset of it):"
    git -C "$REPO" diff "HEAD..$upstream"
    if [ "$YES" -ne 1 ]; then
      if [ -t 0 ]; then
        printf 'apply and re-record trust hashes? [y/N] '
        read -r ans
        case "$ans" in y|Y|yes|YES) ;; *) echo "vstack update: aborted, nothing changed"; exit 1 ;; esac
      else
        echo "vstack update: no terminal to confirm on; re-run with --yes to accept unseen" >&2
        exit 1
      fi
    fi
    git -C "$REPO" merge --ff-only "$upstream" && "$REPO/install.sh"
    ;;
  install)
    "$REPO/install.sh" "$@"
    ;;
  doctor)
    D="$HOME/.config/agents/bin/doctor"
    [ -x "$D" ] || D="$REPO/bin/doctor"
    "$D" "$@"
    ;;
  overlay)
    if [ $# -lt 1 ]; then
      echo "vstack overlay: missing <repo> argument" >&2
      exit 2
    fi
    "$REPO/overlay.sh" "$@"
    ;;
  verify)
    # Wrapped rather than exec'd so a structured local run-log entry can be written after --
    # verify.sh's own stdout/stderr/exit code pass through unchanged (PIPESTATUS[0], not the
    # pipeline's own status, so `set -o pipefail` never substitutes tee's exit code for it).
    # Parsed from the printed footer ("checks: N declared, M ran, K skipped"), not
    # recomputed -- if that line's shape ever changes, the parse fails closed to UNKNOWN
    # rather than silently emitting a stale N/M/K that no longer matches what actually ran.
    VERIFY_OUT=$(mktemp)
    "$REPO/.claude/verify.sh" 2>&1 | tee "$VERIFY_OUT"
    VERIFY_RC=${PIPESTATUS[0]}
    VERIFY_FOOTER=$(grep -m1 '^checks: [0-9]* declared, [0-9]* ran, [0-9]* skipped$' "$VERIFY_OUT")
    VERIFY_DECL=$(printf '%s' "$VERIFY_FOOTER" | sed -n 's/^checks: \([0-9]*\) declared.*/\1/p')
    VERIFY_RAN=$(printf '%s' "$VERIFY_FOOTER" | sed -n 's/.* \([0-9]*\) ran,.*/\1/p')
    VERIFY_SKIP=$(printf '%s' "$VERIFY_FOOTER" | sed -n 's/.* \([0-9]*\) skipped$/\1/p')
    rm -f "$VERIFY_OUT"
    [ "$VERIFY_RC" -eq 0 ] && VERIFY_OUTCOME=VERIFIED || VERIFY_OUTCOME=FAILED
    runlog_write "verify" "$VERIFY_OUTCOME" "$VERIFY_DECL" "$VERIFY_RAN" "$VERIFY_SKIP" "$VERIFY_RC"
    exit "$VERIFY_RC"
    ;;
  self-test)
    cmd_self_test
    exit $?
    ;;
  test)
    "$REPO/tests/auto-trigger.sh" "$@"
    ;;
  receipt)
    # Render the last /team handoff trail. The elevator-mirror argument for this is real: the
    # work already happened, the log was already written, and the only thing missing was a way
    # to look at it. Nothing here computes a verdict -- it reads rows that were written as the
    # run went, which is why it cannot flatter.
    #
    # And it can look bad on purpose. A trail where every decision is `proceed` gets called out
    # below, because a tech lead who never rejected anything is indistinguishable from one who
    # never read what came back. That is the difference between a mirror in the lift and a floor
    # counter that ticks faster than the car moves.
    log=${2:-.audit/team-log.tsv}
    [ -s "$log" ] || { echo "no handoff trail at $log — run /team, which writes one as it goes"; exit 1; }
    rows=$(( $(grep -c . "$log") - 1 ))
    printf '\n  %s handoff%s\n\n' "$rows" "$([ "$rows" = 1 ] || echo s)"
    column -s"$(printf '\t')" -t "$log" | sed '1s/^/  /; 1s/$//; 2,$s/^/  /'
    rej=$(awk -F'\t' 'NR>1 && ($4 ~ /broken|fail/ || $6 ~ /reject|halt/)' "$log" | grep -c .)
    printf '\n'
    if [ "$rej" -gt 0 ]; then
      printf '  %s row%s where a phase was rejected or halted. The bar was held.\n\n' \
        "$rej" "$([ "$rej" = 1 ] || echo s)"
    else
      printf '  Every row is a pass. Either nothing went wrong, or nothing was read.\n'
      printf '  A trail that cannot show a rejection is not evidence that one was not needed.\n\n'
    fi
    ;;

  trust)
    # `trust` means only "a matching sha256 line exists in ~/.config/agents/verify-trust", and
    # verify-gate.sh's Stop hook runs whatever hashes to that line unattended forever after.
    # A plain CLI command with no confirmation made this command itself the delivery mechanism
    # for the thing it exists to stop: a hostile CONTRIBUTING.md saying "run `vstack trust .`
    # to enable the pre-commit gate" gets an agent to arm unattended execution of a script
    # nobody human read. `update` already solved this shape at the block above -- refuse
    # without a TTY, require --yes for automation -- so the same pattern is ported here rather
    # than invented twice.
    YES=0
    d=""
    for a in "$@"; do
      case "$a" in
        --yes|-y) YES=1 ;;
        *) [ -z "$d" ] && d="$a" ;;
      esac
    done
    d="${d:-$PWD}"
    [ -f "$d/.claude/verify.sh" ] || { echo "vstack trust: no .claude/verify.sh in $d" >&2; exit 2; }
    v="$(cd "$d/.claude" && pwd)/verify.sh"
    if [ "$YES" -ne 1 ]; then
      if [ -t 0 ]; then
        echo "this arms the Stop-hook gate to execute $v (and whatever install.sh-shaped"
        echo "scripts, sourced files, or package.json/pyproject.toml/Cargo.toml manifests it"
        echo "references at the repo root) unattended, on every commit, from now on."
        echo "the boundary this command exists to protect is anchored on a human having read"
        echo "the script first -- nothing after this point checks that you actually did."
        printf 'have you read %s yourself, just now? [y/N] ' "$v"
        read -r ans
        case "$ans" in y|Y|yes|YES) ;; *) echo "vstack trust: aborted, nothing trusted"; exit 1 ;; esac
      else
        echo "vstack trust: no terminal to confirm on; re-run with --yes to accept unseen" >&2
        exit 1
      fi
    fi
    if command -v shasum >/dev/null 2>&1; then h=$(shasum -a 256 "$v" | cut -d' ' -f1)
    else h=$(sha256sum "$v" | cut -d' ' -f1); fi
    ts="$HOME/.config/agents/verify-trust"
    mkdir -p "${ts%/*}"
    root="$(cd "$d" && pwd)"
    # verify.sh is rarely the only thing that runs. This repo's own gate executes
    # install.sh --dry-run and overlay.sh, so hashing one file while those two float free draws
    # the trust boundary around the entry point instead of around the code. Record the scripts
    # at the repo root too, and the gate re-checks every recorded file before running anything.
    tmp=$(mktemp)
    grep -vF "  $root/" "$ts" 2>/dev/null | grep -vF "  $v" > "$tmp" || true
    printf '%s  %s\n' "$h" "$v" >> "$tmp"
    # Which scripts those are is read out of verify.sh, not hardcoded. The list used to be
    # vstack's own four -- install.sh, overlay.sh, uninstall.sh, bootstrap.sh -- which covers this
    # repo and no one else's: a stranger whose gate calls ./scripts/ci.sh got the entry point
    # hashed and the code it runs floating free, which is the exact hole the boundary exists to
    # close. Any .sh path written literally in verify.sh that resolves to a file inside the repo
    # is recorded and re-checked.
    #
    # A path verify.sh builds at runtime is still invisible here, and no amount of scanning fixes
    # that. The boundary is anchored on a human reading the script before running this command;
    # what the hashes buy is that it cannot change afterwards without the gate noticing.
    #
    # `source foo` / `. foo` loads and executes a file with no `.sh` suffix requirement at all --
    # the grep above only ever matched files literally named *.sh, so a dot-sourced `lib/helpers`
    # was invisible to it even though it runs with the same authority as verify.sh itself.
    src_refs=$(grep -E '^[[:space:]]*(source|\.)[[:space:]]+[A-Za-z0-9_./-]+' "$v" 2>/dev/null \
               | sed -E 's/^[[:space:]]*(source|\.)[[:space:]]+([A-Za-z0-9_./-]+).*/\2/' | sort -u)
    #
    # create-verification-skill's own default template (claude/verify.sh.tmpl) branches on
    # package.json / pyproject.toml / Cargo.toml and shells out to `npm run`, `uv run pytest`,
    # `cargo test` -- none of which is a *.sh or source/. path, so none of it was ever in the
    # hashed set. Editing scripts.test in package.json (or the dependency graph / build backend
    # in pyproject.toml, or Cargo.toml's deps/[patch]/build.rs) gets code execution at Stop-hook
    # time in an already-trusted repo without the trust hash ever moving.
    #
    # verify-gate.sh can only compare one real file's current bytes against a recorded hash, so
    # "hash just the scripts object" isn't available here -- that needs the checker to parse and
    # re-derive a subset on every run, and this command doesn't own verify-gate.sh. The whole
    # manifest is the finest grain this mechanism has, so a manifest is tracked whole (any edit,
    # including an unrelated dependency bump, re-arms confirmation -- deliberately coarse, not
    # narrowed, because a narrower claim would not be true). Lockfiles and build.rs are tracked
    # alongside the manifest because they carry execution paths the manifest text alone doesn't:
    # a pinned git/registry source in uv.lock or Cargo.lock, and Cargo's build.rs, which cargo
    # runs by filesystem convention with no textual reference in Cargo.toml at all.
    #
    # None of this reaches a local path dependency's own file content (`{path = "../x"}` in
    # pyproject.toml's [tool.uv.sources], or a path entry in Cargo.toml/[patch]) -- those are
    # recorded by path, not by content hash, in either ecosystem's lockfile, so editing files
    # under a path dependency runs new code without retriggering trust. That gap is documented,
    # not closed, for the same reason a runtime-built *.sh path isn't: no static scan closes it.
    manifests=""
    grep -qE 'npm (run|test)|package\.json' "$v" 2>/dev/null && manifests="$manifests package.json"
    grep -qE 'uv run|pyproject\.toml' "$v" 2>/dev/null && manifests="$manifests pyproject.toml uv.lock"
    grep -qE 'cargo (test|build)|Cargo\.toml' "$v" 2>/dev/null && manifests="$manifests Cargo.toml Cargo.lock build.rs"
    # Resolve symlinks before trusting a path: a repo-root-looking relative path (no leading
    # `/`, no `..`) can still walk out of the repo through a symlinked directory, and a human
    # reading "trusted: N scripts at the repo root" is being told something false if one of them
    # is actually outside it. `realpath` is standard on current macOS and Linux; the `pwd -P`
    # fallback only resolves symlinked directory components, not a symlinked leaf file itself --
    # a narrower guarantee, kept rather than skipped, on hosts without realpath.
    if command -v realpath >/dev/null 2>&1; then root_phys=$(realpath "$root" 2>/dev/null)
    else root_phys=$(cd "$root" && pwd -P); fi
    n=1
    for extra in $(printf '%s\n' "$src_refs" \
                     "$(grep -ohE '[A-Za-z0-9_][A-Za-z0-9_./-]*\.sh' "$v" 2>/dev/null | sed 's|^\./||')" \
                     "$manifests" | sort -u) \
                 install.sh overlay.sh uninstall.sh bootstrap.sh; do
      [ -n "$extra" ] || continue
      case "$extra" in /*|*..*) continue ;; esac
      [ -f "$root/$extra" ] || continue
      if command -v realpath >/dev/null 2>&1; then extra_phys=$(realpath "$root/$extra" 2>/dev/null)
      else extra_phys=$(cd "$(dirname "$root/$extra")" 2>/dev/null && pwd -P)/$(basename "$extra"); fi
      case "$extra_phys" in "$root_phys"/*) ;; *) continue ;; esac
      [ "$root/$extra" = "$v" ] && continue
      grep -qF "  $root/$extra" "$tmp" && continue
      if command -v shasum >/dev/null 2>&1; then eh=$(shasum -a 256 "$root/$extra" | cut -d' ' -f1)
      else eh=$(sha256sum "$root/$extra" | cut -d' ' -f1); fi
      printf '%s  %s\n' "$eh" "$root/$extra" >> "$tmp"
      n=$((n+1))
    done
    mv "$tmp" "$ts"
    echo "trusted: $v"
    [ "$n" -gt 1 ] && echo "         plus $((n-1)) script(s) at the repo root that it executes"
    echo "the Stop-hook verify gate will now run it (re-run 'vstack trust' after editing any of them)"
    ;;
  uninstall)
    "$REPO/uninstall.sh" "$@"
    ;;
  *)
    echo "vstack: unknown command: $CMD" >&2
    usage >&2
    exit 2
    ;;
esac
