#!/usr/bin/env bash
# vstack — one-word dispatcher for the common vstack operations.
#
# Usage: vstack <update|install|doctor|overlay|verify|uninstall|help> [args...]
set -uo pipefail

usage() {
  cat <<'EOF'
usage: vstack <command> [args...]

commands:
  update [--yes]      fetch, show the full diff of everything about to be merged, confirm, install
  install [args...]   run the repo's install.sh (args passed through, e.g. --dry-run)
  doctor [args...]    run ~/.config/agents/bin/doctor (args passed through, e.g. --drift)
  overlay <repo>       run the repo's overlay.sh against <repo>
  verify               run the repo's .claude/verify.sh
  test                 run tests/auto-trigger.sh (live skill-firing regression; needs claude auth, ~15 min)
  trust [repo-dir] [--yes]
                        trust a repo's .claude/verify.sh so the Stop-hook gate runs it unattended;
                        refuses without a terminal to confirm on unless --yes is given
  uninstall [args...]  run the repo's uninstall.sh (args passed through)
  help                 show this message

The repo is resolved the same way as `doctor --drift`: $VSTACK_DIR, else ~/.vstack, else the
git root containing this script's parent (if it has claude/settings.json).
EOF
}

resolve_vstack_repo() {
  if [ -n "${VSTACK_DIR:-}" ] && [ -f "$VSTACK_DIR/claude/settings.json" ]; then
    printf '%s\n' "$VSTACK_DIR"; return 0
  fi
  # install.sh records where it last ran from, so a repo cloned anywhere is findable.
  if [ -f "$HOME/.config/agents/vstack-repo" ]; then
    p=$(cat "$HOME/.config/agents/vstack-repo")
    [ -f "$p/claude/settings.json" ] && { printf '%s\n' "$p"; return 0; }
  fi
  if [ -f "$HOME/.vstack/claude/settings.json" ]; then
    printf '%s\n' "$HOME/.vstack"; return 0
  fi
  sdir=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || sdir=""
  root=""
  [ -n "$sdir" ] && root=$(cd "$sdir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)
  if [ -n "${root:-}" ] && [ -f "$root/claude/settings.json" ]; then
    printf '%s\n' "$root"; return 0
  fi
  return 1
}

CMD="${1:-}"
[ $# -gt 0 ] && shift

case "$CMD" in
  ""|help|-h|--help)
    usage
    exit 0
    ;;
esac

REPO=$(resolve_vstack_repo) || {
  echo "vstack: no vstack repo found (checked \$VSTACK_DIR, ~/.vstack, and this script's git root)" >&2
  echo "vstack: set \$VSTACK_DIR to your checkout, or clone one to ~/.vstack" >&2
  exit 1
}

case "$CMD" in
  update)
    # This used to be `git pull && install.sh`, which re-recorded the trust hashes for
    # whatever arrived — the one unattended path where new code got trusted sight unseen.
    # Now: fetch, show the incoming commits and the full diff of every script the gate
    # executes, and ask. Without a terminal, refuse rather than assume; --yes is the
    # explicit escape hatch for automation.
    YES=0
    for a in "$@"; do case "$a" in --yes|-y) YES=1 ;; esac; done
    # Bare fetch with fetch.prune=true deletes local tags not on the remote. See bin/doctor:260
    # and the 2026-08-20 incident where unpushed release tags were silently destroyed.
    git -C "$REPO" fetch -q --no-tags --no-prune --no-write-fetch-head origin || exit 1
    upstream=$(git -C "$REPO" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || upstream=""
    if [ -z "$upstream" ] || ! git -C "$REPO" rev-parse --verify -q "$upstream" >/dev/null 2>&1; then
      # No configured upstream, or it points at a ref that does not exist locally. This is the
      # shape the README's own pin quickstart leaves behind: `VSTACK_REF=vX.Y.Z bash
      # bootstrap.sh` clones with `--depth 1 --branch vX.Y.Z`, which sets remote.origin.fetch to
      # fetch *only that tag* -- refs/remotes/origin/main never gets created. The old code
      # silently fell back to the literal string "origin/main", which then failed to resolve;
      # git wrote that to stderr (discarded), rev-list produced empty stdout, and the empty
      # check below read that identically to "nothing to update". A pinned install could never
      # discover it was behind.
      #
      # Repair rather than refuse: widen the fetch refspec to track main and drop the shallow
      # boundary. Unshallowing matters as much as the refspec does -- a shallow fetch of just
      # main's tip would let the rev-list check below detect drift, but `git merge --ff-only`
      # further down needs real ancestry to prove main is a fast-forward of HEAD, which two
      # disconnected shallow histories cannot supply.
      upstream=origin/main
      repair_err=$(git -C "$REPO" config remote.origin.fetch "+refs/heads/main:refs/remotes/origin/main" 2>&1)
      if [ -z "$repair_err" ]; then
        if [ "$(git -C "$REPO" rev-parse --is-shallow-repository 2>/dev/null)" = true ]; then
          repair_err=$(git -C "$REPO" fetch -q --no-tags --no-prune --no-write-fetch-head --unshallow origin 2>&1)
        else
          repair_err=$(git -C "$REPO" fetch -q --no-tags --no-prune --no-write-fetch-head origin 2>&1)
        fi
      fi
      if ! git -C "$REPO" rev-parse --verify -q "$upstream" >/dev/null 2>&1; then
        echo "vstack update: could not resolve $upstream even after repairing the fetch refspec" >&2
        [ -n "$repair_err" ] && echo "               git said: $repair_err" >&2
        echo "               this checkout may not be a clone of the vstack repo, or main was renamed;" >&2
        echo "               re-clone with 'git clone $(git -C "$REPO" remote get-url origin 2>/dev/null || echo "$REPO")' to recover" >&2
        exit 1
      fi
    fi
    revlist_out=$(git -C "$REPO" rev-list -n 1 "HEAD..$upstream" 2>&1)
    revlist_rc=$?
    if [ "$revlist_rc" -ne 0 ]; then
      # Never let a failed comparison read as "nothing to update" -- that is the exact defect
      # class this block exists to close. An unresolved or unwalkable ref must be loud.
      echo "vstack update: could not compare HEAD to $upstream: $revlist_out" >&2
      exit 1
    fi
    if [ -z "$revlist_out" ]; then
      echo "vstack update: already up to date with $upstream; reinstalling to clear drift"
      exec "$REPO/install.sh"
    fi
    echo "incoming from $upstream:"
    git -C "$REPO" log --oneline "HEAD..$upstream"
    # install.sh deploys nearly this whole repo -- claude/hooks/*.sh, claude/agents, commands,
    # skills, bin/*, settings.json, CLAUDE.md -- so a diff scoped to "the scripts the gate
    # executes" was a narrower promise than this command actually carries out. It could (and
    # did, in the v1.28.0 audit) print "no changes to the scripts the gate executes" while
    # about to install a rewritten claude/hooks/guard-destructive.sh, because that file was
    # never in the reviewed set.
    #
    # Fixed by reviewing everything that is about to be merged, not a hand-maintained subset of
    # it. A list of "trusted" paths would need a new entry every time install.sh grows another
    # `cp` target, and forgetting one silently reopens this exact hole -- a full diff cannot
    # drift out of sync with what gets installed, because it does not try to describe that
    # surface at all. The gate-executing scripts are still called out separately below, with a
    # warning, because those are the ones an attacker would target first: change one of them
    # and the next `vstack trust` or `install.sh` run re-signs the tampered version.
    GATE_SCRIPTS="install.sh overlay.sh uninstall.sh bootstrap.sh .claude/verify.sh"
    gate_changed=""
    for g in $GATE_SCRIPTS; do
      git -C "$REPO" diff --quiet "HEAD..$upstream" -- "$g" 2>/dev/null || gate_changed="$gate_changed $g"
    done
    if [ -n "$gate_changed" ]; then
      echo
      echo "WARNING: this changes scripts the gate itself executes, and will re-trust them on merge:$gate_changed"
    fi
    changed=$(git -C "$REPO" diff --name-only "HEAD..$upstream")
    nfiles=$(printf '%s\n' "$changed" | grep -c .)
    echo
    echo "full diff, $upstream vs HEAD ($nfiles file(s) changed -- install.sh deploys nearly all of this repo, so this is everything that is about to land, not a reviewed subset of it):"
    git -C "$REPO" diff "HEAD..$upstream"
    if [ "$YES" -ne 1 ]; then
      if [ -t 0 ]; then
        printf 'apply and re-record trust hashes? [y/N] '
        read -r ans
        case "$ans" in y|Y|yes|YES) ;; *) echo "vstack update: aborted, nothing changed"; exit 1 ;; esac
      else
        echo "vstack update: no terminal to confirm on; re-run with --yes to accept unseen" >&2
        exit 1
      fi
    fi
    git -C "$REPO" merge --ff-only "$upstream" && "$REPO/install.sh"
    ;;
  install)
    "$REPO/install.sh" "$@"
    ;;
  doctor)
    D="$HOME/.config/agents/bin/doctor"
    [ -x "$D" ] || D="$REPO/bin/doctor"
    "$D" "$@"
    ;;
  overlay)
    if [ $# -lt 1 ]; then
      echo "vstack overlay: missing <repo> argument" >&2
      exit 2
    fi
    "$REPO/overlay.sh" "$@"
    ;;
  verify)
    "$REPO/.claude/verify.sh"
    ;;
  test)
    "$REPO/tests/auto-trigger.sh" "$@"
    ;;
  receipt)
    # Render the last /team handoff trail. The elevator-mirror argument for this is real: the
    # work already happened, the log was already written, and the only thing missing was a way
    # to look at it. Nothing here computes a verdict -- it reads rows that were written as the
    # run went, which is why it cannot flatter.
    #
    # And it can look bad on purpose. A trail where every decision is `proceed` gets called out
    # below, because a tech lead who never rejected anything is indistinguishable from one who
    # never read what came back. That is the difference between a mirror in the lift and a floor
    # counter that ticks faster than the car moves.
    log=${2:-.audit/team-log.tsv}
    [ -s "$log" ] || { echo "no handoff trail at $log — run /team, which writes one as it goes"; exit 1; }
    rows=$(( $(grep -c . "$log") - 1 ))
    printf '\n  %s handoff%s\n\n' "$rows" "$([ "$rows" = 1 ] || echo s)"
    column -s"$(printf '\t')" -t "$log" | sed '1s/^/  /; 1s/$//; 2,$s/^/  /'
    rej=$(awk -F'\t' 'NR>1 && ($4 ~ /broken|fail/ || $6 ~ /reject|halt/)' "$log" | grep -c .)
    printf '\n'
    if [ "$rej" -gt 0 ]; then
      printf '  %s row%s where a phase was rejected or halted. The bar was held.\n\n' \
        "$rej" "$([ "$rej" = 1 ] || echo s)"
    else
      printf '  Every row is a pass. Either nothing went wrong, or nothing was read.\n'
      printf '  A trail that cannot show a rejection is not evidence that one was not needed.\n\n'
    fi
    ;;

  trust)
    # `trust` means only "a matching sha256 line exists in ~/.config/agents/verify-trust", and
    # verify-gate.sh's Stop hook runs whatever hashes to that line unattended forever after.
    # A plain CLI command with no confirmation made this command itself the delivery mechanism
    # for the thing it exists to stop: a hostile CONTRIBUTING.md saying "run `vstack trust .`
    # to enable the pre-commit gate" gets an agent to arm unattended execution of a script
    # nobody human read. `update` already solved this shape at the block above -- refuse
    # without a TTY, require --yes for automation -- so the same pattern is ported here rather
    # than invented twice.
    YES=0
    d=""
    for a in "$@"; do
      case "$a" in
        --yes|-y) YES=1 ;;
        *) [ -z "$d" ] && d="$a" ;;
      esac
    done
    d="${d:-$PWD}"
    [ -f "$d/.claude/verify.sh" ] || { echo "vstack trust: no .claude/verify.sh in $d" >&2; exit 2; }
    v="$(cd "$d/.claude" && pwd)/verify.sh"
    if [ "$YES" -ne 1 ]; then
      if [ -t 0 ]; then
        echo "this arms the Stop-hook gate to execute $v (and whatever install.sh-shaped"
        echo "scripts it references at the repo root) unattended, on every commit, from now on."
        echo "the boundary this command exists to protect is anchored on a human having read"
        echo "the script first -- nothing after this point checks that you actually did."
        printf 'have you read %s yourself, just now? [y/N] ' "$v"
        read -r ans
        case "$ans" in y|Y|yes|YES) ;; *) echo "vstack trust: aborted, nothing trusted"; exit 1 ;; esac
      else
        echo "vstack trust: no terminal to confirm on; re-run with --yes to accept unseen" >&2
        exit 1
      fi
    fi
    if command -v shasum >/dev/null 2>&1; then h=$(shasum -a 256 "$v" | cut -d' ' -f1)
    else h=$(sha256sum "$v" | cut -d' ' -f1); fi
    ts="$HOME/.config/agents/verify-trust"
    mkdir -p "${ts%/*}"
    root="$(cd "$d" && pwd)"
    # verify.sh is rarely the only thing that runs. This repo's own gate executes
    # install.sh --dry-run and overlay.sh, so hashing one file while those two float free draws
    # the trust boundary around the entry point instead of around the code. Record the scripts
    # at the repo root too, and the gate re-checks every recorded file before running anything.
    tmp=$(mktemp)
    grep -vF "  $root/" "$ts" 2>/dev/null | grep -vF "  $v" > "$tmp" || true
    printf '%s  %s\n' "$h" "$v" >> "$tmp"
    # Which scripts those are is read out of verify.sh, not hardcoded. The list used to be
    # vstack's own four -- install.sh, overlay.sh, uninstall.sh, bootstrap.sh -- which covers this
    # repo and no one else's: a stranger whose gate calls ./scripts/ci.sh got the entry point
    # hashed and the code it runs floating free, which is the exact hole the boundary exists to
    # close. Any .sh path written literally in verify.sh that resolves to a file inside the repo
    # is recorded and re-checked.
    #
    # A path verify.sh builds at runtime is still invisible here, and no amount of scanning fixes
    # that. The boundary is anchored on a human reading the script before running this command;
    # what the hashes buy is that it cannot change afterwards without the gate noticing.
    n=1
    for extra in $(grep -ohE '[A-Za-z0-9_][A-Za-z0-9_./-]*\.sh' "$v" 2>/dev/null | sed 's|^\./||' | sort -u) \
                 install.sh overlay.sh uninstall.sh bootstrap.sh; do
      case "$extra" in /*|*..*) continue ;; esac
      [ -f "$root/$extra" ] || continue
      [ "$root/$extra" = "$v" ] && continue
      grep -qF "  $root/$extra" "$tmp" && continue
      if command -v shasum >/dev/null 2>&1; then eh=$(shasum -a 256 "$root/$extra" | cut -d' ' -f1)
      else eh=$(sha256sum "$root/$extra" | cut -d' ' -f1); fi
      printf '%s  %s\n' "$eh" "$root/$extra" >> "$tmp"
      n=$((n+1))
    done
    mv "$tmp" "$ts"
    echo "trusted: $v"
    [ "$n" -gt 1 ] && echo "         plus $((n-1)) script(s) at the repo root that it executes"
    echo "the Stop-hook verify gate will now run it (re-run 'vstack trust' after editing any of them)"
    ;;
  uninstall)
    "$REPO/uninstall.sh" "$@"
    ;;
  *)
    echo "vstack: unknown command: $CMD" >&2
    usage >&2
    exit 2
    ;;
esac
