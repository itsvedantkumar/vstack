# secrets.env — installed to ~/.config/agents/secrets.env (chmod 600), sourced by
# .zshenv and by every MCP wrapper in bin/.
#
# install.sh copies this file ONLY when no secrets.env exists. It will never overwrite
# real credentials. This example is committed; the real file must never be.
#
# Fill in what you use and leave the rest empty — the wrappers only need their own vars.

# --- Cloudflare (cloudflare-mcp wrapper, wrangler deploys) ---
export CLOUDFLARE_API_TOKEN=
export CLOUDFLARE_ACCOUNT_ID=

# --- Transactional email ---

# --- Anthropic SDK key, for APPS you build ---
# Deliberately NOT named ANTHROPIC_API_KEY: that name makes Claude Code bill API credits
# instead of your subscription. The shell wrapper strips it, doctor checks it stays unset.
export ANTHROPIC_SDK_API_KEY=

# --- Optional: Superset notifier (hooks post events here when set) ---
export SUPERSET_HOME_DIR=
