<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vstack.claude-task.weekly-yc-cto-audit</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.config/agents/bin/claude-task.sh</string>
		<string>weekly-yc-cto-audit</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key><integer>1</integer>
		<key>Hour</key><integer>6</integer>
		<key>Minute</key><integer>11</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude/scheduled-tasks/.logs/weekly-yc-cto-audit.launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude/scheduled-tasks/.logs/weekly-yc-cto-audit.launchd.log</string>
</dict>
</plist>
