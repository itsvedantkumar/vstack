#!/bin/sh
# =============================================================================
# ss — thin wrapper over the Spaceship API (https://spaceship.dev/api/v1)
#
#   ss GET  /domains/example.com
#   ss GET  /dns/records/example.com            # take/skip added automatically
#   ss PUT  /domains/example.com/nameservers '{"provider":"custom","hosts":[...]}'
#   ss DELETE /dns/records/example.com '[{"type":"A","name":"@","value":"1.2.3.4"}]'
#
# Reads SPACESHIP_API_KEY / SPACESHIP_API_SECRET from the environment, or from
# ~/.config/agents/secrets.env if they are not already set.
#
# Why this exists: every paginated endpoint rejects a request that omits `skip`
# with a 422 rather than defaulting it, and the raw errors are a single JSON
# line that is easy to misread as a network failure. This adds the pagination
# params, pretty-prints, and turns HTTP status into a readable diagnosis.
# =============================================================================
set -eu

[ -n "${SPACESHIP_API_KEY:-}" ] || {
  [ -f "$HOME/.config/agents/secrets.env" ] && . "$HOME/.config/agents/secrets.env"
}
[ -n "${SPACESHIP_API_KEY:-}" ] || { echo "ss: SPACESHIP_API_KEY is not set" >&2; exit 1; }
[ -n "${SPACESHIP_API_SECRET:-}" ] || { echo "ss: SPACESHIP_API_SECRET is not set" >&2; exit 1; }

METHOD=${1:?usage: ss METHOD PATH [JSON_BODY]}
RPATH=${2:?usage: ss METHOD PATH [JSON_BODY]}
BODY=${3:-}

# Paginated collections require BOTH take and skip; omitting skip is a 422.
case "$RPATH" in
  *take=*) ;;
  /domains|/dns/records/*)
    case "$RPATH" in
      *\?*) RPATH="$RPATH&take=100&skip=0" ;;
      *)    RPATH="$RPATH?take=100&skip=0" ;;
    esac ;;
esac

TMP=$(mktemp)
trap 'rm -f "$TMP" "$TMP.h"' EXIT

if [ -n "$BODY" ]; then
  CODE=$(curl -sS -o "$TMP" -w '%{http_code}' -X "$METHOD" \
    "https://spaceship.dev/api/v1$RPATH" \
    -H "X-Api-Key: $SPACESHIP_API_KEY" \
    -H "X-Api-Secret: $SPACESHIP_API_SECRET" \
    -H "Content-Type: application/json" \
    -D "$TMP.h" \
    --data "$BODY")
else
  CODE=$(curl -sS -o "$TMP" -w '%{http_code}' -X "$METHOD" \
    "https://spaceship.dev/api/v1$RPATH" \
    -H "X-Api-Key: $SPACESHIP_API_KEY" \
    -H "X-Api-Secret: $SPACESHIP_API_SECRET" \
    -D "$TMP.h")
fi

node -e '
const fs = require("fs");
const body = fs.readFileSync(process.argv[1], "utf8");
const code = Number(process.argv[2]);
let parsed = null;
try { parsed = JSON.parse(body); } catch {}
if (parsed) console.log(JSON.stringify(parsed, null, 2));
else if (body.trim()) console.log(body);

if (code >= 400) {
  const hint = {
    401: "Bad or missing X-Api-Key / X-Api-Secret.",
    403: "The API key lacks the scope this endpoint needs (domains:read/write, dnsrecords:read/write).",
    404: "No such resource on this account — check the domain spelling and that it is on this Spaceship account.",
    409: "Conflicts with current state (e.g. already in that state, or a pending operation).",
    422: "Validation failed. The data[] array names the offending field — note that take AND skip are both required on collections.",
    429: "Rate limited. data.rateLimitRule states the exact window; domain info is 5 per domain per 300s and nameserver updates are 5 per domain per 300s."
  }[code];
  console.error(`\nHTTP ${code}${hint ? " — " + hint : ""}`);
  process.exit(1);
}
if (code === 202) {
  const id = (fs.readFileSync(process.argv[1] + ".h", "utf8")
    .match(/spaceship-async-operationid:\s*(\S+)/i) || [])[1];
  console.error(`\nHTTP 202 accepted — async operation${id ? " " + id : ""}.` +
    `\nPoll: ss GET /async-operations/${id || "<id>"}`);
}
' "$TMP" "$CODE"
