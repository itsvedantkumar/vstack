{
  "description": "Routes situations to skills so they fire without a slash command, and runs the repo's .claude/verify.sh gate before the agent is allowed to finish.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "VSTACK_PROFILE=skills \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-session-context.sh\"",
            "statusMessage": "skill routing"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/verify-gate.sh\""
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/skill-mandate.sh\""
          }
        ]
      }
    ]
  }
}
